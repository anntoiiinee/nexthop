---
import { t, type Lang } from '@/i18n/ui';
import { toolUrl, type Tool } from '@/data/tools';

interface Props { tool: Tool; lang: Lang; heading?: 'h2' | 'h3'; }
const { tool, lang, heading: Heading = 'h3' } = Astro.props;
---
<a
  href={toolUrl(lang, tool.slug)}
  class="group flex flex-col rounded-xl border border-slate-200 bg-white p-6 transition hover:border-sky-400 hover:shadow-sm dark:border-slate-800 dark:bg-slate-950 dark:hover:border-sky-500/60"
>
  <span class="inline-flex size-12 items-center justify-center rounded-lg bg-sky-50 font-mono text-sm font-bold text-sky-600 dark:bg-sky-500/10 dark:text-sky-400">
    {tool.badge}
  </span>
  <Heading class="mt-4 font-semibold text-slate-900 group-hover:text-sky-600 dark:text-white dark:group-hover:text-sky-400">
    {tool.title[lang]}
  </Heading>
  <p class="mt-2 flex-1 text-sm text-slate-600 dark:text-slate-400">{tool.description[lang]}</p>
  <div class="mt-4 flex flex-wrap gap-2 text-xs font-medium">
    {tool.tags.map((tag) => (
      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-slate-600 dark:bg-slate-800 dark:text-slate-400">#{tag}</span>
    ))}
  </div>
  <span class="mt-4 text-sm font-medium text-sky-600 dark:text-sky-400">
    {t(lang, 'tools.open')} <span class="inline-block transition group-hover:translate-x-1">→</span>
  </span>
</a>
