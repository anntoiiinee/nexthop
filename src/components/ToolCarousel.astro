---
// Carrousel des outils sur l'accueil : défilement horizontal natif (doigt, molette, clavier) avec points d'arrêt,
// et boutons précédent / suivant qui avancent d'une page. Sans JavaScript, le défilement natif reste disponible.
import type { Lang } from '@/i18n/ui';
import { tools } from '@/data/tools';
import ToolCard from './ToolCard.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const copy = {
  fr: { region: 'Outils', prev: 'Outils précédents', next: 'Outils suivants' },
  en: { region: 'Tools', prev: 'Previous tools', next: 'Next tools' },
}[lang];

const navButton = 'inline-flex size-9 items-center justify-center rounded-full border border-slate-300 text-slate-600 transition hover:border-sky-400 hover:text-sky-600 disabled:pointer-events-none disabled:opacity-30 dark:border-slate-700 dark:text-slate-400 dark:hover:text-sky-400';
---
<div data-carousel role="region" aria-roledescription="carousel" aria-label={copy.region} class="mt-8">
  <ul
    data-track
    id={`tool-carousel-${lang}`}
    class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-6 overflow-x-auto px-4 pb-4 [scrollbar-width:thin]"
  >
    {tools.map((tool) => (
      <li class="flex w-[85%] shrink-0 snap-start sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)] [&>a]:w-full">
        <ToolCard tool={tool} lang={lang} />
      </li>
    ))}
  </ul>

  <div data-nav hidden class="mt-2 flex justify-end gap-2">
    <button type="button" data-prev aria-controls={`tool-carousel-${lang}`} aria-label={copy.prev} class={navButton}>
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true"><path fill-rule="evenodd" d="M12.8 4.2a.75.75 0 0 1 0 1.06L8.06 10l4.74 4.74a.75.75 0 1 1-1.06 1.06l-5.27-5.27a.75.75 0 0 1 0-1.06l5.27-5.27a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" /></svg>
    </button>
    <button type="button" data-next aria-controls={`tool-carousel-${lang}`} aria-label={copy.next} class={navButton}>
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true"><path fill-rule="evenodd" d="M7.2 15.8a.75.75 0 0 1 0-1.06L11.94 10 7.2 5.26A.75.75 0 1 1 8.26 4.2l5.27 5.27a.75.75 0 0 1 0 1.06L8.26 15.8a.75.75 0 0 1-1.06 0Z" clip-rule="evenodd" /></svg>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const nav = root.querySelector<HTMLElement>('[data-nav]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      nav.hidden = max <= 1;                       // tout tient à l'écran : pas de boutons
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };

    // Une page = la largeur visible ; les points d'arrêt réalignent ensuite sur le début d'une carte
    const go = (dir: number) =>
      track.scrollBy({ left: dir * track.clientWidth, behavior: reduceMotion.matches ? 'auto' : 'smooth' });

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  });
</script>
