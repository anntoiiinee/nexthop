---
// Bouton de fin de chapitre : marquer le chapitre comme lu, ou annuler.
import { t, type Lang } from '@/i18n/ui';

interface Props { id: string; lang: Lang }
const { id, lang } = Astro.props;
---
<div class="not-prose mt-12 flex flex-wrap items-center gap-3 print:hidden">
  <button
    type="button"
    data-progress-toggle={id}
    data-read="false"
    aria-pressed="false"
    class="group inline-flex items-center gap-2 rounded-lg border border-emerald-500 px-4 py-2 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-50 data-[read=true]:bg-emerald-700 data-[read=true]:text-white data-[read=true]:hover:bg-emerald-800 dark:text-emerald-300 dark:hover:bg-emerald-500/10 dark:data-[read=true]:bg-emerald-700 dark:data-[read=true]:text-white dark:data-[read=true]:hover:bg-emerald-800"
  >
    <span aria-hidden="true" class="group-data-[read=true]:hidden">○</span>
    <span aria-hidden="true" class="hidden group-data-[read=true]:inline">✓</span>
    <span class="group-data-[read=true]:hidden">{t(lang, 'progress.mark')}</span>
    <span class="hidden group-data-[read=true]:inline">{t(lang, 'progress.read')}</span>
  </button>
  <p class="text-xs text-slate-500">{t(lang, 'progress.local')}</p>
</div>
