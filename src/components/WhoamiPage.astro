---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { routes, type Lang } from '@/i18n/ui';
import { profile } from '@/data/profile';
import { coffeeUrl, coffeeIcon } from '@/lib/support';
import { t } from '@/i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const copy = {
  fr: {
    ddescription: 'Antoine Lecarpentier, IT Network Specialist, auteur de Next Hop.',
    role: 'IT Network Specialist · Toulouse',
    aboutTitle: 'En bref',
    about: [
      "Je conçois, automatise et sécurise des infrastructures réseau d'entreprise : du switching campus aux fabrics data center, en passant par les firewalls et l'Infrastructure as Code.",
      "Mon quotidien, ce sont les fabrics Arista EVPN-VxLAN déployées avec AVD et CloudVision, NetBox comme source de vérité, des pipelines GitLab CI et de la télémétrie avec gNMIc et Prometheus.",
    ],
    whyTitle: 'Pourquoi Next Hop ?',
    why: [
      "J'ai commencé par un BTS SIO, puis j'ai progressé étape par étape jusqu'aux sujets que je traite aujourd'hui. À chaque marche, j'ai cherché des ressources qui expliquent le pourquoi, pas seulement les commandes.",
      "Next Hop, c'est le blog que j'aurais aimé trouver : des explications claires, des configurations réelles et des retours de terrain, pour aider celles et ceux qui veulent faire leur prochain saut vers le réseau.",
    ],
    experienceTitle: 'Parcours',
    educationTitle: 'Formation',
    stackTitle: 'Stack',
    certsTitle: 'Certifications',
    contactTitle: 'Me retrouver',
    resume: 'CV complet',
    disclaimer: "Les contenus de ce blog n'engagent que moi et ne représentent pas les positions de mes employeurs ou clients, passés ou actuels.",
  },
  en: {
    description: 'Antoine Lecarpentier, IT Network Specialist, author of Next Hop.',
    role: 'IT Network Specialist · Toulouse, France',
    aboutTitle: 'In short',
    about: [
      'I design, automate and secure enterprise network infrastructure: from campus switching to datacenter fabrics, firewalls and Infrastructure as Code.',
      'My day-to-day is Arista EVPN-VxLAN fabrics deployed with AVD and CloudVision, NetBox as source of truth, GitLab CI pipelines, and telemetry with gNMIc and Prometheus.',
    ],
    whyTitle: 'Why Next Hop?',
    why: [
      "I started with a two-year IT degree and progressed step by step to the topics I work on today. At every stage, I looked for resources that explained the why, not just the commands.",
      "Next Hop is the blog I wish I had found: clear explanations, real configurations and field experience, to help anyone ready to take their next hop into networking.",
    ],
    experienceTitle: 'Experience',
    educationTitle: 'Education',
    stackTitle: 'Stack',
    certsTitle: 'Certifications',
    contactTitle: 'Find me',
    resume: 'Full resume',
    disclaimer: 'The content of this blog reflects my own views only and does not represent the positions of my current or past employers or clients.',
  },
}[lang];

const h2 = 'text-xl font-bold tracking-tight text-slate-900 dark:text-white';
const linkBtn = 'rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium transition hover:border-sky-400 hover:text-sky-600 dark:border-slate-700 dark:hover:text-sky-400';
---
<BaseLayout title="whoami | Next Hop" description={copy.description} lang={lang} alternates={routes.whoami}>
  <div class="mx-auto max-w-4xl px-4 py-16">

    <!-- En-tête -->
    <p class="font-mono text-sm text-slate-500"><span class="text-sky-500">$</span> whoami</p>
    <div class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-center">
      <Image src={profile.avatar} alt={profile.name} width={224} height={224} loading="eager" class="size-28 rounded-full ring-4 ring-sky-500/20" />
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">{profile.name}</h1>
        <p class="mt-2 text-lg text-slate-600 dark:text-slate-400">{copy.role}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href={profile.links.linkedin} target="_blank" rel="noopener" class={linkBtn}>LinkedIn</a>
          <a href={profile.links.github} target="_blank" rel="noopener" class={linkBtn}>GitHub</a>
          <a href={profile.links.resume} target="_blank" rel="noopener" class={linkBtn}>{copy.resume} ↗</a>
          {coffeeUrl && (
            <a href={coffeeUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-[#FFDD00] px-4 py-2 text-sm font-semibold text-slate-900 transition hover:brightness-95">
              <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d={coffeeIcon} /></svg>
              {t(lang, 'support.coffee')}
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Chiffres -->
    <dl class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {profile.stats.map((s) => (
        <div class="rounded-xl border border-slate-200 p-5 dark:border-slate-800">
          <dt class="text-sm text-slate-500">{s[lang]}</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-slate-900 dark:text-white">{s.value}</dd>
        </div>
      ))}
    </dl>

    <!-- En bref + Pourquoi -->
    <div class="mt-16 grid gap-12 md:grid-cols-2">
      <section>
        <h2 class={h2}>{copy.aboutTitle}</h2>
        {copy.about.map((p) => <p class="mt-4 text-slate-600 dark:text-slate-400">{p}</p>)}
      </section>
      <section>
        <h2 class={h2}>{copy.whyTitle}</h2>
        {copy.why.map((p) => <p class="mt-4 text-slate-600 dark:text-slate-400">{p}</p>)}
      </section>
    </div>

    <!-- Parcours -->
    <section class="mt-16">
      <h2 class={h2}>{copy.experienceTitle}</h2>
      <ol class="mt-8 space-y-10 border-l border-slate-200 pl-8 dark:border-slate-800">
        {profile.experience.map((job) => (
          <li class="relative">
            <span class="absolute -left-[38.5px] top-1 size-3 rounded-full border-2 border-sky-500 bg-white dark:bg-slate-950"></span>
            <p class="font-mono text-xs text-slate-500">{job.period[lang]}</p>
            <h3 class="mt-1 font-semibold text-slate-900 dark:text-white">{job.role[lang]}</h3>
            <p class="text-sm text-sky-600 dark:text-sky-400">{job.company[lang]}</p>
            <ul class="mt-3 space-y-1.5 text-sm text-slate-600 dark:text-slate-400">
              {job.points[lang].map((p) => (
                <li class="flex gap-2"><span class="text-sky-500">▸</span><span>{p}</span></li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <!-- Formation -->
    <section class="mt-16">
      <h2 class={h2}>{copy.educationTitle}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {profile.education.map((e) => (
          <div class="rounded-xl border border-slate-200 p-5 dark:border-slate-800">
            <p class="font-mono text-xs text-slate-500">{e.period}</p>
            <h3 class="mt-2 font-semibold text-slate-900 dark:text-white">{e.degree[lang]}</h3>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{e.school}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Stack + Certifications -->
    <section class="mt-16">
      <h2 class={h2}>{copy.stackTitle}</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {profile.stack.map((group) => (
          <div>
            <p class="font-mono text-xs font-medium text-sky-600 dark:text-sky-400">// {group.title[lang]}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="rounded-md bg-slate-100 px-2.5 py-1 text-sm dark:bg-slate-800">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <h2 class:list={[h2, 'mt-12']}>{copy.certsTitle}</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {profile.certifications.map((c) => (
          <span class="rounded-md border border-sky-300 bg-sky-50 px-3 py-1 font-mono text-sm text-sky-700 dark:border-sky-500/30 dark:bg-sky-500/10 dark:text-sky-300">{c}</span>
        ))}
      </div>
    </section>

        <!-- Mention -->
    <p class="mt-16 border-t border-slate-200 pt-6 text-sm italic text-slate-500 dark:border-slate-800">
      {copy.disclaimer}
    </p>

  </div>
</BaseLayout>