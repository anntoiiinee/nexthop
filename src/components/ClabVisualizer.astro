---
import fs from 'node:fs';
import path from 'node:path';
import type { Lang } from '@/i18n/ui';

interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;

// Exemples : les topologies des labs du site, lues au build
const labsDir = path.join(process.cwd(), 'public', 'labs');
const samples = fs
  .readdirSync(labsDir)
  .filter((dir) => fs.existsSync(path.join(labsDir, dir, 'topology.clab.yml')))
  .sort()
  .map((dir) => ({ name: dir, yaml: fs.readFileSync(path.join(labsDir, dir, 'topology.clab.yml'), 'utf-8') }));
const initial = samples.find((s) => s.name === 'dc-fabric') ?? samples[0];

const copy = {
  fr: {
    title: 'Visualiseur ContainerLab',
    label: 'Collez un fichier topology.clab.yml',
    samples: 'Exemples : les labs du site',
    nodes: ['équipement', 'équipements'],
    links: ['lien', 'liens'],
    yamlError: 'YAML invalide',
    noNodes: 'Aucun équipement trouvé : le fichier doit contenir une section topology.nodes.',
    skipped: 'Liens ignorés, car un équipement n’est pas déclaré dans topology.nodes :',
    aria: 'Topologie',
    privacy: 'Le schéma est calculé dans votre navigateur : rien n’est envoyé.',
  },
  en: {
    title: 'ContainerLab visualizer',
    label: 'Paste a topology.clab.yml file',
    samples: 'Examples: the site’s labs',
    nodes: ['node', 'nodes'],
    links: ['link', 'links'],
    yamlError: 'Invalid YAML',
    noNodes: 'No node found: the file must contain a topology.nodes section.',
    skipped: 'Links ignored, because a node is not declared in topology.nodes:',
    aria: 'Topology',
    privacy: 'The diagram is computed in your browser: nothing is sent.',
  },
}[lang];
---
<div
  data-clab-viz
  data-i18n={JSON.stringify(copy)}
  data-samples={JSON.stringify(samples)}
  class="not-prose my-8 rounded-xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/50"
>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <label class="font-mono text-xs font-medium uppercase tracking-wide text-sky-600 dark:text-sky-400" for="clab-yaml">{copy.title}</label>
    <label class="flex items-center gap-2 text-xs text-slate-500">
      {copy.samples}
      <select data-sample class="rounded-lg border border-slate-300 bg-white px-2 py-1 font-mono text-xs text-slate-800 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200">
        {samples.map((s) => <option value={s.name} selected={s.name === initial?.name}>{s.name}</option>)}
      </select>
    </label>
  </div>
  <p class="mt-1 text-xs text-slate-500">{copy.label}</p>
  <textarea
    id="clab-yaml"
    data-yaml
    rows="14"
    spellcheck="false"
    class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-3 font-mono text-xs leading-5 text-slate-900 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
  >{initial?.yaml}</textarea>
  <p class="mt-1 text-xs text-slate-500">{copy.privacy}</p>

  <p data-error hidden class="mt-4 whitespace-pre-wrap rounded-lg border border-rose-200 bg-rose-50 p-3 font-mono text-xs text-rose-700 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-300"></p>
  <p data-summary class="mt-4 font-mono text-xs text-slate-500"></p>
  <div data-skipped hidden class="mt-2 text-xs text-amber-700 dark:text-amber-300"></div>
  <figure data-diagram class="mt-3 overflow-x-auto rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950"></figure>
</div>

<script>
  import { parse } from 'yaml';
  import { layoutClab, clabSvg, kindLabels } from '@/lib/clab';

  document.querySelectorAll<HTMLElement>('[data-clab-viz]').forEach((root) => {
    const t = JSON.parse(root.dataset.i18n!);
    const samples: { name: string; yaml: string }[] = JSON.parse(root.dataset.samples!);
    const textarea = root.querySelector<HTMLTextAreaElement>('[data-yaml]')!;
    const select = root.querySelector<HTMLSelectElement>('[data-sample]')!;
    const error = root.querySelector<HTMLElement>('[data-error]')!;
    const summary = root.querySelector<HTMLElement>('[data-summary]')!;
    const skipped = root.querySelector<HTMLElement>('[data-skipped]')!;
    const diagram = root.querySelector<HTMLElement>('[data-diagram]')!;
    const plural = (n: number, words: string[]) => `${n} ${words[n > 1 ? 1 : 0]}`;

    const showError = (message: string) => {
      error.textContent = message;
      error.hidden = false;
      diagram.classList.add('opacity-40');
    };

    const render = () => {
      let doc: any;
      try {
        doc = parse(textarea.value);
      } catch (e) {
        showError(`${t.yamlError} : ${(e as Error).message}`);
        return;
      }
      const layout = layoutClab(doc);
      const nodes = layout.rows.flat();
      if (nodes.length === 0) {
        showError(t.noNodes);
        return;
      }
      error.hidden = true;
      diagram.classList.remove('opacity-40');

      const kinds = [...new Set(nodes.map((n) => kindLabels[n.kind] ?? n.kind))].join(' · ');
      summary.textContent = [doc?.name, plural(nodes.length, t.nodes), plural(layout.edges.length, t.links), kinds]
        .filter(Boolean)
        .join('  ·  ');

      skipped.hidden = layout.skippedLinks.length === 0;
      skipped.textContent = layout.skippedLinks.length ? `${t.skipped} ${layout.skippedLinks.join(', ')}` : '';

      diagram.innerHTML = clabSvg(layout, `${t.aria} ${doc?.name ?? ''}`);
    };

    let timer: number | undefined;
    textarea.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(render, 200);
    });
    select.addEventListener('change', () => {
      textarea.value = samples.find((s) => s.name === select.value)?.yaml ?? '';
      render();
    });
    render();
  });
</script>
