---
// En-tête des sections de l'accueil : petite étiquette, titre, et texte d'introduction.
// Sur grand écran, le titre est à gauche et l'introduction à droite, alignés en haut :
// le texte occupe la largeur au lieu de laisser une moitié vide.
// <SectionHeader eyebrow="Public" title="Pour qui ?" link={{ href: '/outils', label: 'Tous les outils →' }}>
//   <p>Introduction…</p>
// </SectionHeader>
interface Props {
  eyebrow?: string;
  title: string;
  link?: { href: string; label: string };
}

const { eyebrow, title, link } = Astro.props;
const hasIntro = Astro.slots.has('default');
---
<div class:list={['grid gap-x-12 gap-y-4', hasIntro && 'lg:grid-cols-12 lg:items-start']}>
  <div class:list={[hasIntro ? 'lg:col-span-5' : 'flex flex-wrap items-end justify-between gap-4']}>
    <div>
      {eyebrow && <p class="font-mono text-xs uppercase tracking-widest text-sky-600 dark:text-sky-400">{eyebrow}</p>}
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-balance text-slate-900 sm:text-3xl dark:text-white">{title}</h2>
    </div>
    {!hasIntro && link && (
      <a href={link.href} class="text-sm font-medium text-sky-600 hover:underline dark:text-sky-400">{link.label}</a>
    )}
  </div>
  {hasIntro && (
    <div class="text-slate-600 lg:col-span-7 dark:text-slate-400">
      <slot />
      {link && (
        <a href={link.href} class="mt-3 inline-block text-sm font-medium text-sky-600 hover:underline dark:text-sky-400">{link.label}</a>
      )}
    </div>
  )}
</div>
