---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { routes, t, type Lang } from '@/i18n/ui';
import { cheatsheets, cheatsheetUrl } from '@/data/cheatsheets';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<BaseLayout
  title={`${t(lang, 'cheats.title')} | Next Hop`}
  description={t(lang, 'cheats.intro')}
  lang={lang}
  alternates={routes.cheatsheets}
>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">{t(lang, 'cheats.title')}</h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-400">{t(lang, 'cheats.intro')}</p>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {cheatsheets.map((sheet) => (
        <li class="grid">
          <a href={cheatsheetUrl(lang, sheet.slug)} class="group flex flex-col rounded-xl border border-slate-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-sky-400 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900/50 dark:hover:border-sky-500/60">
            <span class="w-fit rounded-lg bg-sky-50 px-2.5 py-1.5 font-mono text-sm font-semibold text-sky-700 dark:bg-sky-500/10 dark:text-sky-300">{sheet.badge}</span>
            <h2 class="mt-4 font-semibold text-slate-900 transition group-hover:text-sky-600 dark:text-white dark:group-hover:text-sky-400">{sheet.title[lang]}</h2>
            <p class="mt-2 flex-1 text-sm text-slate-600 dark:text-slate-400">{sheet.intro[lang]}</p>
            <p class="mt-4 font-mono text-xs text-slate-500">{sheet.head.map((h) => h[lang]).join(' · ')}</p>
            <span class="mt-3 text-sm font-medium text-sky-600 dark:text-sky-400">{t(lang, 'cheats.open')} →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
