---
import fs from 'node:fs';
import path from 'node:path';
import { parse } from 'yaml';
import { layoutClab, clabSvg } from '@/lib/clab';

interface Props {
  name: string;
  file?: string;
}

const { name, file = 'topology.clab.yml' } = Astro.props;

// Le placement et le dessin sont partagés avec le visualiseur ContainerLab (src/lib/clab.ts)
const raw = fs.readFileSync(path.join(process.cwd(), 'public', 'labs', name, file), 'utf-8');
const doc = parse(raw) ?? {};
const svg = clabSvg(layoutClab(doc), `Topologie du lab ${doc.name ?? name}`);
---
<figure class="not-prose my-6 overflow-x-auto rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950">
  <Fragment set:html={svg} />
</figure>
