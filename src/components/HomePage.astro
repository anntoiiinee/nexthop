---
import ProgressBar from './ProgressBar.astro';
import SectionHeader from './SectionHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import TutorialCard from './TutorialCard.astro';
import LogoMarquee from './LogoMarquee.astro';
import ToolCarousel from './ToolCarousel.astro';
import TermOfTheDay from './TermOfTheDay.astro';
import Faq from './Faq.astro';
import { readdirSync } from 'node:fs';
import { join } from 'node:path';
import { routes, t, type Lang } from '@/i18n/ui';
import { roadmap } from '@/data/roadmap';
import { courseUrl, chapterUrl, getPublished, getCourses } from '@/lib/courses';
import { levelColors } from '@/lib/levels';
import { courseDates } from '@/lib/dates';
import ContentDates from './ContentDates.astro';
import { getTutorials, slugOf, tutorialUrl } from '@/lib/content';
import { profile } from '@/data/profile';
import { coffeeUrl, coffeeIcon } from '@/lib/support';
import { websiteSchema, authorSchema } from '@/lib/seo';
import { tools, toolUrl } from '@/data/tools';
import { glossary } from '@/data/glossary';
import { startHere, type AudienceKey, type StartStep } from '@/data/startHere';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const posts = (await getTutorials(lang)).filter((p) => !p.data.wip); // les tutoriels en cours ne comptent pas encore
const latest = posts.slice(0, 6);
const published = await getPublished(lang);
const courseList = await getCourses(lang);
const courseDatesBySlug = Object.fromEntries(courseList.map((c) => [c.slug, courseDates(c)]));
// Niveau de chaque formation : celui de la langue affichée, sinon celui de l'autre langue (formation pas encore traduite)
const courseLevelBySlug = Object.fromEntries(
  [...(await getCourses(lang === 'fr' ? 'en' : 'fr')), ...courseList].map((c) => [c.slug, c.landing.data.level])
);

// Étapes « Par où commencer ? » : on ne garde que celles publiées dans cette langue
const tutorialSlugs = new Set(posts.map((p) => slugOf(p.id)));
const toolSlugs = new Set(tools.map((tool) => tool.slug));
function resolveStep(step: StartStep): { href: string; label: string } | null {
  const label = step.label[lang];
  switch (step.kind) {
    case 'course': return published.courses.has(step.course) ? { href: courseUrl(lang, step.course), label } : null;
    case 'chapter': return published.chapters.has(`${step.course}/${step.chapter}`) ? { href: chapterUrl(lang, step.course, step.chapter), label } : null;
    case 'tutorial': return tutorialSlugs.has(step.slug) ? { href: tutorialUrl(lang, step.slug), label } : null;
    case 'tool': return toolSlugs.has(step.slug) ? { href: toolUrl(lang, step.slug), label } : null;
  }
}
const stepsFor = (key: AudienceKey) => startHere[key].map(resolveStep).filter((s) => s !== null);

// Chiffres du site, calculés au build ; un compteur à 0 n'est pas affiché
let labCount = 0;
try {
  // Seuls les dossiers avec une topologie ContainerLab comptent (pas les labs Docker Compose des tutoriels)
  const labsDir = join(process.cwd(), 'public/labs');
  labCount = readdirSync(labsDir, { withFileTypes: true })
    .filter((d) => d.isDirectory() && readdirSync(join(labsDir, d.name)).some((f) => f.endsWith('.clab.yml'))).length;
} catch {}

const copy = {
  fr: {
    title: 'Next Hop · Votre prochain saut vers le réseau',
    badge: 'Réseau & sécurité · étudiants et reconversions',
    h1: 'Votre prochain saut vers le',
    h1Accent: 'réseau',
    intro: "Des tutoriels clairs et concrets, écrits par un IT Network Specialist, pour passer des bases jusqu'aux fabrics EVPN-VxLAN et à l'automatisation.",
    ctaTutorials: 'Voir les tutoriels',
    ctaCourses: 'Les formations',
    audienceTitle: 'Pour qui ?',
    audienceEyebrow: 'Public',
    audienceIntro: "Pour celles et ceux qui apprennent le réseau sur le terrain plutôt que dans les livres : en formation, en reconversion ou déjà en poste.",
    audienceHighlights: ["Des bases jusqu'aux sujets des grandes entreprises", 'De vraies configurations, sur plusieurs constructeurs', 'Des labs gratuits, à lancer chez soi'],
    audiencePoints: 'Ce que vous trouverez ici',
    startLabel: 'Par où commencer',
    stats: {
      tutorials: ['tutoriel', 'tutoriels'],
      chapters: ['chapitre', 'chapitres'],
      tools: ['outil interactif', 'outils interactifs'],
      labs: ['lab ContainerLab', 'labs ContainerLab'],
      terms: ['terme défini', 'termes définis'],
    },
    toolsTitle: 'Des outils pour s’entraîner',
    toolsEyebrow: (n: number) => `${n} outils · dans le navigateur`,
    toolsIntro: 'Calculer, découper, décoder, se tester : directement dans le navigateur, sans rien installer ni créer de compte.',
    toolsAll: 'Tous les outils →',
    faqTitle: 'Questions fréquentes',
    audience: [
      { key: 'students', icon: '🎓', title: 'Étudiants', text: "BTS SIO, BUT R&T, licence pro, école d'ingénieurs ou alternance : vous avez les cours, il vous manque souvent la pratique et la vision de ce qu'on attend en entreprise.",
        points: ["Les notions du programme (OSI, VLAN, subnetting, routage) expliquées autrement, avec des schémas", "Des labs gratuits pour pratiquer sur un vrai système réseau, Arista cEOS", "Les configurations et les réflexes attendus en stage et en alternance"] },
      { key: 'careerChangers', icon: '🔀', title: 'Reconversion', text: "Vous venez d'un autre métier et visez le réseau ou la cybersécurité ? Pas de prérequis : on part des bases, sans jargon inutile, avec un fil conducteur clair.",
        points: ["Un parcours ordonné en 8 sauts, du câble jusqu'au cloud", "Chaque sigle expliqué au survol, grâce au glossaire", "Des retours terrain pour comprendre le métier au quotidien, pas seulement la théorie"] },
      { key: 'admins', icon: '🛠️', title: 'Admins & techs', text: "Administrateur système, technicien support ou réseau : vous faites déjà de l'IT et voulez passer au niveau suivant, ou prendre en main un réseau d'entreprise.",
        points: ["Les sujets d'entreprise : BGP, EVPN-VxLAN, firewalls, proxys et load balancing", "Des exemples multi-constructeurs : Arista, Cisco, Fortinet, Palo Alto, Stormshield, F5", "L'automatisation : Python, Ansible, NetBox et AVD"] },
      { key: 'developers', icon: '💻', title: 'Devs, DevOps & cloud', text: "Vos applications tournent sur un réseau que vous ne voyez pas. Quand ça ne marche pas, la question tombe toujours : « c'est le réseau ? » Ici, vous apprendrez à y répondre.",
        points: ["Ce qui se passe sous vos applications : TCP, DNS, TLS, proxys et load balancers", "Les outils de diagnostic pour prouver où est le problème", "Les bases du réseau dans le cloud : VPC, filtrage, VPN et Terraform (saut 8)"] },
    ],
    roadmapTitle: 'Le parcours, saut par saut',
    roadmapEyebrow: (hops: number, chapters: number) => `${hops} sauts · ${chapters} chapitres`,
    roadmapIntro: "Un chemin progressif, des fondamentaux jusqu'aux sujets rencontrés dans les data centers et les grandes entreprises. Chaque saut affiche son niveau : suivez-les dans l'ordre, ou entrez directement par celui qui vous concerne.",
    levelsLabel: 'Niveaux',
    methodEyebrow: 'La méthode',
    latestEyebrow: 'Nouveautés',
    methodTitle: 'Des tutoriels pensés pour la pratique',
    method: [
      { title: 'Des configs réelles', text: "Pas de pseudo-code : des configurations telles qu'on les déploie, sur des équipements du marché." },
      { title: 'Des sorties CLI commentées', text: 'Chaque show command est expliquée : quoi regarder, et ce que ça signifie.' },
      { title: 'Des labs à reproduire', text: 'Des topologies ContainerLab pour refaire chaque tutoriel chez soi, gratuitement.' },
      { title: 'Des retours terrain', text: 'Les pièges et bonnes pratiques vus en production, que les cours ne mentionnent pas.' },
    ],
    latestTitle: 'Derniers tutoriels',
    seeAll: 'Tout voir →',
    empty: 'Les premiers tutoriels arrivent très bientôt.',
    authorTitle: 'Qui écrit ?',
    authorText: "Antoine, IT Network Specialist. Passé par un BTS SIO, une licence pro et un master, il travaille aujourd'hui sur des fabrics EVPN-VxLAN et l'automatisation réseau dans l'aéronautique.",
    authorCta: 'En savoir plus',
  },
  en: {
    title: 'Next Hop · Your next hop into networking',
    badge: 'Networking & security · students and career changers',
    h1: 'Your next hop into',
    h1Accent: 'networking',
    intro: 'Clear, hands-on tutorials written by an IT Network Specialist, taking you from the fundamentals to EVPN-VxLAN fabrics and automation.',
    ctaTutorials: 'Browse tutorials',
    ctaCourses: 'Courses',
    audienceTitle: 'Who is it for?',
    audienceEyebrow: 'Audience',
    audienceIntro: 'For people learning networking hands-on rather than from books: in training, changing careers, or already on the job.',
    audienceHighlights: ['From the basics to the topics met in large companies', 'Real configurations, across several vendors', 'Free labs you can run at home'],
    audiencePoints: 'What you will find here',
    startLabel: 'Where to start',
    stats: {
      tutorials: ['tutorial', 'tutorials'],
      chapters: ['chapter', 'chapters'],
      tools: ['interactive tool', 'interactive tools'],
      labs: ['ContainerLab lab', 'ContainerLab labs'],
      terms: ['defined term', 'defined terms'],
    },
    toolsTitle: 'Tools to practice',
    toolsEyebrow: (n: number) => `${n} tools · in your browser`,
    toolsIntro: 'Calculate, split, decode, test yourself: right in your browser, with nothing to install and no account to create.',
    toolsAll: 'All tools →',
    faqTitle: 'Frequently asked questions',
    audience: [
      { key: 'students', icon: '🎓', title: 'Students', text: 'Networking degree, engineering school or apprenticeship: you have the lectures, but often lack hands-on practice and a sense of what companies actually expect.',
        points: ['Curriculum topics (OSI, VLANs, subnetting, routing) explained differently, with diagrams', 'Free labs to practise on a real network OS, Arista cEOS', 'The configurations and reflexes expected in internships and apprenticeships'] },
      { key: 'careerChangers', icon: '🔀', title: 'Career changers', text: 'Coming from another field and aiming for networking or cybersecurity? No prerequisites: we start from the basics, without unnecessary jargon, with a clear common thread.',
        points: ['An ordered path in 8 hops, from the cable to the cloud', 'Every acronym explained on hover, thanks to the glossary', 'Field stories to understand the day-to-day job, not just the theory'] },
      { key: 'admins', icon: '🛠️', title: 'Sysadmins & techs', text: 'Systems administrator, support or network technician: you already work in IT and want to reach the next level, or take charge of a corporate network.',
        points: ['Enterprise topics: BGP, EVPN-VxLAN, firewalls, proxies and load balancing', 'Multi-vendor examples: Arista, Cisco, Fortinet, Palo Alto, Stormshield, F5', 'Automation: Python, Ansible, NetBox and AVD'] },
      { key: 'developers', icon: '💻', title: 'Devs, DevOps & cloud', text: 'Your applications run on a network you do not see. When something breaks, the question always comes: "is it the network?" Here, you will learn to answer it.',
        points: ['What happens under your applications: TCP, DNS, TLS, proxies and load balancers', 'The troubleshooting tools to prove where the problem is', 'Cloud networking basics: VPCs, filtering, VPN and Terraform (hop 8)'] },
    ],
    roadmapTitle: 'The path, hop by hop',
    roadmapEyebrow: (hops: number, chapters: number) => `${hops} hops · ${chapters} chapters`,
    roadmapIntro: 'A progressive path, from the fundamentals to the topics you meet in data centers and large companies. Each hop shows its level: follow them in order, or jump straight to the one that matters to you.',
    levelsLabel: 'Levels',
    methodEyebrow: 'The method',
    latestEyebrow: "What's new",
    methodTitle: 'Tutorials built for practice',
    method: [
      { title: 'Real configs', text: 'No pseudo-code: configurations as they are actually deployed, on real-world gear.' },
      { title: 'Annotated CLI output', text: 'Every show command is explained: what to look at, and what it means.' },
      { title: 'Reproducible labs', text: 'ContainerLab topologies so you can rebuild every tutorial at home, for free.' },
      { title: 'Field experience', text: "Production pitfalls and best practices that courses don't mention." },
    ],
    latestTitle: 'Latest tutorials',
    seeAll: 'See all →',
    empty: 'The first tutorials are coming soon.',
    authorTitle: 'Who writes this?',
    authorText: "Antoine, IT Network Specialist. After a two-year IT degree, a professional bachelor's and a master's, he now works on EVPN-VxLAN fabrics and network automation in aerospace.",
    authorCta: 'Learn more',
  },
}[lang];

const stats = ([
  ['tutorials', posts.length],
  ['chapters', published.chapters.size],
  ['tools', tools.length],
  ['labs', labCount],
  ['terms', Object.keys(glossary).length],
] as const)
  .filter(([, value]) => value > 0)
  .map(([key, value]) => ({ value, label: copy.stats[key][value > 1 ? 1 : 0] }));

---
<BaseLayout title={copy.title} lang={lang} alternates={routes.home} jsonLd={[websiteSchema(lang, t(lang, 'site.description')), authorSchema(lang)]}>

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      style="background: radial-gradient(ellipse at top, rgb(14 165 233 / 0.12), transparent 60%);"
    ></div>
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 lg:grid-cols-2 lg:py-28">
      <div>
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-medium text-sky-700 dark:border-sky-500/30 dark:bg-sky-500/10 dark:text-sky-300">
          {copy.badge}
        </p>
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-white">
          {copy.h1} <span class="text-sky-500">{copy.h1Accent}</span>.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-slate-600 dark:text-slate-400">{copy.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={routes.tutorials[lang]} class="rounded-lg bg-sky-500 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-sky-600">
            {copy.ctaTutorials}
          </a>
          <a href={routes.courses[lang]} class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-sky-400 hover:text-sky-600 dark:border-slate-700 dark:text-slate-300 dark:hover:text-sky-400">
            {copy.ctaCourses}
          </a>
        </div>

        <dl class="mt-10 flex flex-wrap gap-x-8 gap-y-4">
          {stats.map((stat) => (
            <div class="flex flex-col-reverse">
              <dt class="text-xs text-slate-500">{stat.label}</dt>
              <dd class="font-mono text-2xl font-bold text-slate-900 dark:text-white">{stat.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="hidden overflow-hidden rounded-xl border border-slate-800 bg-slate-900 shadow-2xl lg:block">
        <div class="flex items-center gap-2 border-b border-slate-800 px-4 py-3">
          <span class="size-3 rounded-full bg-rose-500/80"></span>
          <span class="size-3 rounded-full bg-amber-500/80"></span>
          <span class="size-3 rounded-full bg-emerald-500/80"></span>
          <span class="ml-2 font-mono text-xs text-slate-500">~/career</span>
        </div>
        <pre class="p-6 font-mono text-sm leading-relaxed text-slate-300"><span class="text-sky-400">$</span> traceroute new-career
 1  curiosity         0.4 ms
 2  fundamentals      1.2 ms
 3  bgp-evpn          3.8 ms
 4  automation        5.1 ms
 5  <span class="text-emerald-400">next-hop ✓</span>       <span class="text-emerald-400">reached</span></pre>
      </div>
    </div>
  </section>

  <!-- Technologies -->
  <LogoMarquee lang={lang} />

  <!-- Pour qui -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <SectionHeader eyebrow={copy.audienceEyebrow} title={copy.audienceTitle}>
      <p class="text-lg">{copy.audienceIntro}</p>
      <ul class="mt-4 space-y-1.5 text-sm text-slate-700 dark:text-slate-300">
        {copy.audienceHighlights.map((h) => (
          <li class="flex gap-2"><span class="text-emerald-500" aria-hidden="true">✓</span><span>{h}</span></li>
        ))}
      </ul>
    </SectionHeader>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {copy.audience.map((a) => {
        const steps = stepsFor(a.key as AudienceKey);
        return (
          <div class="flex flex-col rounded-xl border border-slate-200 p-6 dark:border-slate-800">
            <p class="text-3xl">{a.icon}</p>
            <h3 class="mt-4 font-semibold text-slate-900 dark:text-white">{a.title}</h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{a.text}</p>
            <p class="mt-5 font-mono text-xs text-slate-500">{copy.audiencePoints}</p>
            <ul class="mt-2 flex-1 space-y-1.5 text-sm text-slate-700 dark:text-slate-300">
              {a.points.map((point) => (
                <li class="flex gap-2"><span class="text-emerald-500">✓</span><span>{point}</span></li>
              ))}
            </ul>
            {steps.length > 0 && (
              <div class="mt-5 border-t border-slate-200 pt-4 dark:border-slate-800">
                <p class="font-mono text-xs text-slate-500">{copy.startLabel}</p>
                <ol class="mt-2 space-y-1.5 text-sm">
                  {steps.map((step, i) => (
                    <li>
                      <a href={step.href} class="group flex gap-2 font-medium text-slate-700 transition hover:text-sky-600 dark:text-slate-300 dark:hover:text-sky-400">
                        <span class="font-mono text-sky-500">{i + 1}.</span>
                        <span>{step.label} <span class="inline-block transition group-hover:translate-x-0.5">→</span></span>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <!-- Parcours -->
  <section class="border-y border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/40">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <SectionHeader eyebrow={copy.roadmapEyebrow(roadmap.length, roadmap.reduce((n, step) => n + step.chapters.length, 0))} title={copy.roadmapTitle}>
        <p>{copy.roadmapIntro}</p>
        <p class="mt-4 flex flex-wrap items-center gap-2 text-xs">
          <span class="font-mono text-slate-500">{copy.levelsLabel}</span>
          {(['beginner', 'intermediate', 'advanced'] as const).map((level) => (
            <span class:list={['rounded-full px-2 py-0.5 font-medium', levelColors[level]]}>{t(lang, `level.${level}`)}</span>
          ))}
        </p>
      </SectionHeader>

      <!-- Grille à sous-grilles : les mêmes parties de chaque carte sont alignées sur toute une rangée -->
      <ol class="mt-10 grid gap-x-4 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
        {roadmap.map((step, i) => {
          const courseReady = published.courses.has(step.course);
          const level = courseLevelBySlug[step.course] ?? step.level;
          return (
            <li class="row-span-5 grid grid-rows-subgrid gap-0 rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-950">
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs text-slate-400">hop {i + 1}</span>
                <span class="font-mono text-xs font-medium text-sky-600 dark:text-sky-400">{step.label}</span>
              </div>
              <h3 class="mt-3 font-semibold text-slate-900 dark:text-white">
                {courseReady ? (
                  <a href={courseUrl(lang, step.course)} class="transition hover:text-sky-500">{step.title[lang]} →</a>
                ) : step.title[lang]}
              </h3>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{step.text[lang]}</p>
              <div class="mt-3 flex flex-col items-start gap-1">
                {level && (
                  <span class:list={['rounded-full px-2 py-0.5 text-[11px] font-medium', levelColors[level]]}>
                    {t(lang, `level.${level}`)}
                  </span>
                )}
                {courseDatesBySlug[step.course] && (
                  <ContentDates created={courseDatesBySlug[step.course].created} updated={courseDatesBySlug[step.course].updated} lang={lang} class="text-xs" />
                )}
                {courseReady && (
                  <ProgressBar
                    course={step.course}
                    chapters={step.chapters.filter((c) => published.chapters.has(`${step.course}/${c.slug}`)).map((c) => c.slug)}
                    lang={lang}
                    hideEmpty
                    class="mt-1 w-full"
                  />
                )}
              </div>

              <ul class="mt-4 space-y-1.5 border-t border-slate-200 pt-4 text-sm dark:border-slate-800">
                {step.chapters.map((chapter) =>
                  published.chapters.has(`${step.course}/${chapter.slug}`) ? (
                    <li>
                      <a
                        href={chapterUrl(lang, step.course, chapter.slug)}
                        class="flex gap-1.5 text-slate-700 transition hover:text-sky-600 dark:text-slate-300 dark:hover:text-sky-400"
                      >
                        <span class="text-sky-500">▸</span>{chapter.title[lang]}
                      </a>
                    </li>
                  ) : (
                    <li class="flex items-baseline justify-between gap-2 text-slate-400 dark:text-slate-600">
                      <span>{chapter.title[lang]}</span>
                      <span class="shrink-0 font-mono text-[10px] uppercase">{t(lang, 'courses.soon')}</span>
                    </li>
                  )
                )}
              </ul>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- Outils -->
  {tools.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 pt-16">
      <SectionHeader eyebrow={copy.toolsEyebrow(tools.length)} title={copy.toolsTitle} link={{ href: routes.tools[lang], label: copy.toolsAll }}>
        <p>{copy.toolsIntro}</p>
      </SectionHeader>
      <ToolCarousel lang={lang} />
    </section>
  )}

  <!-- Méthode -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <SectionHeader eyebrow={copy.methodEyebrow} title={copy.methodTitle} />
    <div class="mt-8 grid gap-x-12 gap-y-8 sm:grid-cols-2">
      {copy.method.map((m) => (
        <div class="flex gap-4">
          <span class="mt-0.5 font-mono text-sky-500">&gt;</span>
          <div>
            <h3 class="font-semibold text-slate-900 dark:text-white">{m.title}</h3>
            <p class="mt-1 text-slate-600 dark:text-slate-400">{m.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Derniers tutoriels -->
  <section class="border-t border-slate-200 dark:border-slate-800">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <SectionHeader
        eyebrow={copy.latestEyebrow}
        title={copy.latestTitle}
        link={posts.length > 6 ? { href: routes.tutorials[lang], label: copy.seeAll } : undefined}
      />
      {latest.length > 0 ? (
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {latest.map((post) => <TutorialCard post={post} lang={lang} />)}
        </div>
      ) : (
        <p class="mt-8 text-slate-500">{copy.empty}</p>
      )}
    </div>
  </section>

  <!-- Terme du jour -->
  <section class="border-y border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/40">
    <div class="mx-auto max-w-3xl px-4 py-16">
      <TermOfTheDay lang={lang} />
    </div>
  </section>

  <!-- FAQ -->
  <Faq lang={lang} title={copy.faqTitle} />

  <!-- Auteur -->
  <section class="mx-auto max-w-6xl px-4 pb-20">
    <div class="flex flex-col items-start gap-6 rounded-2xl border border-slate-200 bg-slate-50 p-8 sm:flex-row sm:items-center dark:border-slate-800 dark:bg-slate-900/40">
      <Image src={profile.avatar} alt={profile.name} width={192} height={192} class="size-24 shrink-0 rounded-full ring-4 ring-sky-500/20" />
      <div class="flex-1">
        <p class="font-mono text-xs text-sky-600 dark:text-sky-400">{copy.authorTitle}</p>
        <p class="mt-2 text-slate-700 dark:text-slate-300">{copy.authorText}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {profile.certifications.map((c) => (
            <span class="rounded-md border border-slate-300 px-2 py-0.5 font-mono text-xs dark:border-slate-700">{c}</span>
          ))}
        </div>
      </div>
      <div class="flex shrink-0 flex-col gap-2">
        <a href={routes.whoami[lang]} class="rounded-lg bg-slate-900 px-5 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200">
          {copy.authorCta}
        </a>
        {coffeeUrl && (
          <a href={coffeeUrl} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 rounded-lg bg-[#FFDD00] px-5 py-2.5 text-sm font-semibold text-slate-900 transition hover:brightness-95">
            <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d={coffeeIcon} /></svg>
            {t(lang, 'support.coffee')}
          </a>
        )}
      </div>
    </div>
  </section>

</BaseLayout>