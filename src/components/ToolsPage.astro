---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { routes, t, type Lang } from '@/i18n/ui';
import { tools } from '@/data/tools';
import ToolCard from './ToolCard.astro';
import { communityTools } from '@/data/communityTools';
import { cheatsheets } from '@/data/cheatsheets';

interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<BaseLayout
  title={`${t(lang, 'tools.title')} | Next Hop`}
  description={t(lang, 'tools.intro')}
  lang={lang}
  alternates={routes.tools}
>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
      {t(lang, 'tools.title')}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-400">{t(lang, 'tools.intro')}</p>

    {tools.length > 0 ? (
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((tool) => (
          <li class="grid">
            <ToolCard tool={tool} lang={lang} heading="h2" />
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-10 text-slate-500">{t(lang, 'tools.empty')}</p>
    )}

    <a href={routes.cheatsheets[lang]} class="group mt-10 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-dashed border-sky-300 bg-sky-50/50 p-6 transition hover:border-sky-400 dark:border-sky-500/40 dark:bg-sky-500/5">
      <span>
        <span class="block font-semibold text-slate-900 group-hover:text-sky-600 dark:text-white dark:group-hover:text-sky-400">{t(lang, 'cheats.toolsLink')}</span>
        <span class="mt-1 block text-sm text-slate-600 dark:text-slate-400">{cheatsheets.map((sheet) => sheet.title[lang]).join(' · ')}</span>
      </span>
      <span class="text-sm font-medium text-sky-600 dark:text-sky-400">{t(lang, 'cheats.title')} →</span>
    </a>

    {communityTools.length > 0 && (
      <section class="mt-20">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">{t(lang, 'tools.community')}</h2>
        <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">{t(lang, 'tools.communityIntro')}</p>
        <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {communityTools.map((tool) => (
            <li class="flex flex-col rounded-xl border border-dashed border-slate-300 bg-white p-6 dark:border-slate-700 dark:bg-slate-950">
              <h3 class="font-mono font-semibold text-slate-900 dark:text-white">{tool.name}</h3>
              <p class="mt-1 text-xs text-slate-500">
                {t(lang, 'tools.by')}{' '}
                {tool.authors.map((author, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={author.url} target="_blank" rel="noopener" class="font-medium text-slate-700 hover:text-sky-600 dark:text-slate-300 dark:hover:text-sky-400">{author.name}</a>
                    {author.role && ` (${author.role[lang]})`}
                  </>
                ))}
                {' · '}{t(lang, 'tools.license')} {tool.license}
              </p>
              <p class="mt-3 flex-1 text-sm text-slate-600 dark:text-slate-400">{tool.description[lang]}</p>
              <div class="mt-4 flex flex-wrap gap-2 text-xs font-medium">
                {tool.tags.map((tag) => (
                  <span class="rounded-full bg-slate-100 px-2.5 py-1 text-slate-600 dark:bg-slate-800 dark:text-slate-400">#{tag}</span>
                ))}
              </div>
              <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium">
                <a href={tool.url} target="_blank" rel="noopener" class="text-sky-600 hover:underline dark:text-sky-400">{t(lang, 'tools.repo')} ↗</a>
                {tool.docs && <a href={tool.docs} target="_blank" rel="noopener" class="text-sky-600 hover:underline dark:text-sky-400">{t(lang, 'tools.docs')} ↗</a>}
                {tool.tutorial && <a href={tool.tutorial[lang]} class="text-slate-600 hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400">{t(lang, 'tools.inTutorial')} →</a>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </section>
</BaseLayout>
