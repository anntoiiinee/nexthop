---
import { getCollection } from 'astro:content';
const { lang, slug } = Astro.props; // ex: 'fr', 'bgp-evpn-route-types'
const other = lang === 'fr' ? 'en' : 'fr';

let href = other === 'en' ? '/en/' : '/';
if (slug) {
  const exists = (await getCollection('tutoriels'))
    .some((p) => p.id === `${other}/${slug}`);
  if (exists) href = other === 'en' ? `/en/tutorials/${slug}` : `/tutoriels/${slug}`;
}
---
<a href={href} hreflang={other} aria-label="Change language">🌐 {other.toUpperCase()}</a>