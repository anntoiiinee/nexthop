---
// FAQ en accordéon (<details>, sans JavaScript) + données structurées FAQPage pour les moteurs de recherche.
import type { Lang } from '@/i18n/ui';
import { faq } from '@/data/faq';

interface Props { lang: Lang; title: string; }
const { lang, title } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question[lang],
    acceptedAnswer: { '@type': 'Answer', text: item.answer[lang] },
  })),
};
---
<section class="mx-auto max-w-3xl px-4 py-16">
  <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-white">{title}</h2>

  <div class="mt-10 divide-y divide-slate-200 rounded-xl border border-slate-200 dark:divide-slate-800 dark:border-slate-800">
    {faq.map((item) => (
      <details class="group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-medium text-slate-900 transition hover:text-sky-600 dark:text-white dark:hover:text-sky-400 [&::-webkit-details-marker]:hidden">
          {item.question[lang]}
          <span class="shrink-0 font-mono text-lg text-sky-500 transition group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <div class="px-5 pb-5 text-slate-600 dark:text-slate-400">
          <p>{item.answer[lang]}</p>
          {item.link && (
            <a
              href={item.link.href[lang]}
              target={item.link.external ? '_blank' : undefined}
              rel={item.link.external ? 'noopener' : undefined}
              class="mt-3 inline-block text-sm font-medium text-sky-600 hover:underline dark:text-sky-400"
            >
              {item.link.label[lang]} {item.link.external ? '↗' : '→'}
            </a>
          )}
        </div>
      </details>
    ))}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
