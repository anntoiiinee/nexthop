---
// Découpage d'un bloc d'adresses en sous-réseaux, à l'échelle, avec l'espace libre.
// <AddressSpace base="192.168.10.0/24" subnets={[{ cidr: '192.168.10.0/26', label: 'Utilisateurs' }]} caption="…" />
import { parseCidr, blockSize, networkOf, toIp, toCidrBlocks, usableHosts } from '@/lib/ipv4';
import type { Lang } from '@/i18n/ui';
import { boxTone, type Tone } from './tones';

interface Subnet { cidr: string; label: string }
interface Props { base: string; subnets: Subnet[]; caption?: string; lang?: Lang }
const { base, subnets, caption } = Astro.props;
const lang = (Astro.props.lang ?? Astro.currentLocale ?? 'fr') as Lang;
const copy = {
  fr: { free: 'Libre', hosts: 'hôtes', addresses: 'adresses' },
  en: { free: 'Free', hosts: 'hosts', addresses: 'addresses' },
}[lang];

const parsed = parseCidr(base);
if (!parsed) throw new Error(`<AddressSpace> : bloc invalide "${base}"`);
const start = networkOf(parsed.ip, parsed.prefix);
const total = blockSize(parsed.prefix);
const tones: Tone[] = ['sky', 'emerald', 'violet', 'amber', 'rose'];

type Segment = { network: number; prefix: number; label: string; tone?: Tone };
const used: Segment[] = subnets.map((s, i) => {
  const p = parseCidr(s.cidr);
  if (!p) throw new Error(`<AddressSpace> : sous-réseau invalide "${s.cidr}"`);
  return { network: networkOf(p.ip, p.prefix), prefix: p.prefix, label: s.label, tone: tones[i % tones.length] };
}).sort((a, b) => a.network - b.network);

// Trous entre les sous-réseaux = espace libre, découpé en blocs CIDR valides
const segments: Segment[] = [];
let cursor = start;
for (const s of used) {
  if (s.network > cursor) toCidrBlocks(cursor, s.network).forEach((b) => segments.push({ ...b, label: copy.free }));
  segments.push(s);
  cursor = s.network + blockSize(s.prefix);
}
if (cursor < start + total) toCidrBlocks(cursor, start + total).forEach((b) => segments.push({ ...b, label: copy.free }));

const pct = (s: Segment) => (blockSize(s.prefix) / total) * 100;
---
<figure class="not-prose my-10">
  <div class="flex justify-between font-mono text-xs text-slate-500">
    <span>{toIp(start)}</span>
    <span>{base}</span>
    <span>{toIp(start + total - 1)}</span>
  </div>
  <div class="mt-1 flex h-12 overflow-hidden rounded-lg border border-slate-300 dark:border-slate-700">
    {segments.map((s) => (
      <div
        style={`width: ${pct(s)}%`}
        title={`${s.label} · ${toIp(s.network)}/${s.prefix}`}
        class:list={[
          'flex items-center justify-center overflow-hidden border-r border-white text-[10px] font-semibold last:border-r-0 dark:border-slate-950',
          s.tone ? [boxTone[s.tone].chip, 'text-white'] : 'bg-[repeating-linear-gradient(45deg,transparent,transparent_6px,rgb(148_163_184/0.25)_6px,rgb(148_163_184/0.25)_12px)] text-slate-500',
        ]}
      >
        {pct(s) >= 9 && <span class="truncate px-1 font-mono">/{s.prefix}</span>}
      </div>
    ))}
  </div>

  <ul class="mt-4 grid gap-x-6 gap-y-1.5 text-sm sm:grid-cols-2">
    {segments.map((s) => (
      <li class="flex items-center gap-2">
        <span
          class:list={[
            'size-3 shrink-0 rounded-sm',
            s.tone ? boxTone[s.tone].chip : 'border border-dashed border-slate-400',
          ]}
        ></span>
        <span class:list={['font-medium', s.tone ? 'text-slate-900 dark:text-white' : 'text-slate-500']}>{s.label}</span>
        <span class="font-mono text-xs text-slate-500">
          {toIp(s.network)}/{s.prefix} · {s.tone ? `${usableHosts(s.prefix)} ${copy.hosts}` : `${blockSize(s.prefix)} ${copy.addresses}`}
        </span>
      </li>
    ))}
  </ul>
  {caption && <figcaption class="mt-3 text-center text-sm text-slate-500">{caption}</figcaption>}
</figure>
