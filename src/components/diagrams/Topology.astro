---
// Schéma de topologie réseau en SVG, décrit en données depuis le MDX.
//
// <Topology
//   width={640} height={260}
//   nodes={[{ id: 'sw1', type: 'switch', x: 320, y: 80, label: 'SW1', sub: 'root' }]}
//   links={[{ from: 'sw1', to: 'pc1', label: 'Gi0/1', style: 'blocked' }]}
//   flows={[{ from: 'pc1', to: 'sw1', label: 'broadcast', tone: 'amber' }]}
//   groups={[{ x: 20, y: 20, w: 200, h: 160, label: 'VLAN 10', tone: 'sky' }]}
//   notes={[{ x: 320, y: 240, text: 'Table MAC vide', tone: 'slate' }]}
//   caption="…"
// />
import { svgTone, type Tone } from './tones';

type NodeType = 'router' | 'switch' | 'l3switch' | 'host' | 'server' | 'cloud' | 'firewall';
interface Node { id: string; type: NodeType; x: number; y: number; label?: string; sub?: string; tone?: Tone }
interface Link {
  from: string; to: string;
  label?: string; fromLabel?: string; toLabel?: string;
  style?: 'solid' | 'dashed' | 'blocked' | 'trunk';
  tone?: Tone;
}
interface Flow { from: string; to: string; label?: string; tone?: Tone; offset?: number }
interface Group { x: number; y: number; w: number; h: number; label?: string; tone?: Tone }
interface Note { x: number; y: number; text: string; tone?: Tone; anchor?: 'start' | 'middle' | 'end'; mono?: boolean }

interface Props {
  width?: number;
  height?: number;
  minWidth?: number; // largeur minimale à l'écran (défilement horizontal sur mobile)
  nodes: Node[];
  links?: Link[];
  flows?: Flow[];
  groups?: Group[];
  notes?: Note[];
  caption?: string;
}

const { width = 640, height = 280, minWidth, nodes, links = [], flows = [], groups = [], notes = [], caption } = Astro.props;

const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));
const get = (id: string) => {
  const n = byId[id];
  if (!n) throw new Error(`<Topology> : nœud inconnu "${id}"`);
  return n;
};
const R = 28; // rayon "d'évitement" autour des icônes

// Hauteur occupée par le nom (et le sous-titre) sous un équipement
const labelZone = (n: Node) => (n.label ? (n.sub ? 38 : 24) : 0);
/** Marge supplémentaire aux extrémités d'un segment qui passe par la zone d'étiquette d'un équipement */
function labelClearance(a: Node, b: Node) {
  const dy = b.y - a.y, len = Math.hypot(b.x - a.x, dy) || 1, uy = dy / len;
  return {
    a: uy > 0.3 ? labelZone(a) : 0,   // on quitte a vers le bas : on traverse son étiquette
    b: uy < -0.3 ? labelZone(b) : 0,  // on arrive sur b par le bas : idem
  };
}

/** Segment entre deux nœuds, raccourci pour ne pas toucher les icônes, avec décalage latéral optionnel */
function segment(a: Node, b: Node, offset = 0, trimA = R, trimB = R) {
  const dx = b.x - a.x, dy = b.y - a.y, len = Math.hypot(dx, dy) || 1;
  const ux = dx / len, uy = dy / len, px = -uy * offset, py = ux * offset;
  return {
    x1: a.x + ux * trimA + px, y1: a.y + uy * trimA + py,
    x2: b.x - ux * trimB + px, y2: b.y - uy * trimB + py,
    ux, uy, nx: -uy, ny: ux, len,
  };
}

const halo = 'stroke-white dark:stroke-slate-950';
const labelText = 'fill-slate-900 dark:fill-white';
const iconBody = 'fill-white dark:fill-slate-900';
---
<figure class="not-prose my-10">
  <div class="overflow-x-auto">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      class="mx-auto block h-auto w-full"
      style={`max-width: ${width}px; min-width: ${minWidth ?? Math.min(width, 520)}px`}
      role="img"
      aria-label={caption}
      font-family="Inter Variable, ui-sans-serif, system-ui, sans-serif"
    >
      <!-- Zones (VLAN, domaines…) -->
      {groups.map((g) => {
        const t = svgTone[g.tone ?? 'slate'];
        return (
          <g>
            <rect x={g.x} y={g.y} width={g.w} height={g.h} rx="14" class:list={[t.soft, t.stroke]} stroke-width="1.5" stroke-dasharray="6 4" />
          </g>
        );
      })}

      <!-- Liens -->
      {links.map((l) => {
        const a = get(l.from), b = get(l.to);
        const s = segment(a, b, 0, R - 4, R - 4);
        const clear = labelClearance(a, b);
        const style = l.style ?? 'solid';
        const t = svgTone[l.tone ?? (style === 'blocked' ? 'rose' : 'slate')];
        const mx = (s.x1 + s.x2) / 2, my = (s.y1 + s.y2) / 2;
        const end = (from: 'a' | 'b') => {
          const d = 22 + (from === 'a' ? clear.a : clear.b);
          return from === 'a' ? { x: s.x1 + s.ux * d, y: s.y1 + s.uy * d } : { x: s.x2 - s.ux * d, y: s.y2 - s.uy * d };
        };
        return (
          <g>
            <line
              x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2}
              class={t.stroke}
              stroke-width={style === 'trunk' ? 4 : 2}
              stroke-dasharray={style === 'dashed' || style === 'blocked' ? '6 5' : undefined}
              stroke-linecap="round"
            />
            {style === 'blocked' && (
              <g transform={`translate(${mx} ${my})`} class="stroke-rose-500" stroke-width="3" stroke-linecap="round">
                <circle r="11" class="fill-white dark:fill-slate-950" stroke-width="2" />
                <path d="M-5 -5 L5 5 M5 -5 L-5 5" />
              </g>
            )}
            {l.label && (
              <text
                x={mx + s.nx * (style === 'blocked' ? 22 : 12)} y={my + s.ny * (style === 'blocked' ? 22 : 12) + 4}
                text-anchor="middle" font-size="11" font-family="JetBrains Mono Variable, ui-monospace, monospace"
                class:list={[t.text, halo]} stroke-width="4" paint-order="stroke"
              >{l.label}</text>
            )}
            {[['a', l.fromLabel], ['b', l.toLabel]].map(([side, text]) => text && (() => {
              const p = end(side as 'a' | 'b');
              return (
                <text
                  x={p.x + s.nx * 11} y={p.y + s.ny * 11 + 4}
                  text-anchor="middle" font-size="11" font-weight="700" font-family="JetBrains Mono Variable, ui-monospace, monospace"
                  class:list={[svgTone[l.tone ?? 'slate'].text, halo]} stroke-width="4" paint-order="stroke"
                >{text}</text>
              );
            })())}
          </g>
        );
      })}

      <!-- Flux (trames, paquets) : flèches décalées le long des liens -->
      {flows.map((f) => {
        const a = get(f.from), b = get(f.to);
        const t = svgTone[f.tone ?? 'sky'];
        const clear = labelClearance(a, b);
        const s = segment(a, b, f.offset ?? 14, R + 4 + clear.a, R + 6 + clear.b);
        const head = 8;
        const hx = s.x2, hy = s.y2;
        const p1 = `${hx - s.ux * head + s.nx * head * 0.6},${hy - s.uy * head + s.ny * head * 0.6}`;
        const p2 = `${hx - s.ux * head - s.nx * head * 0.6},${hy - s.uy * head - s.ny * head * 0.6}`;
        const mx = (s.x1 + s.x2) / 2, my = (s.y1 + s.y2) / 2;
        const side = (f.offset ?? 14) >= 0 ? 1 : -1;
        return (
          <g>
            <line x1={s.x1} y1={s.y1} x2={hx - s.ux * 4} y2={hy - s.uy * 4} class={t.stroke} stroke-width="2.5" stroke-linecap="round" />
            <polygon points={`${hx},${hy} ${p1} ${p2}`} class={t.fill} />
            {f.label && (
              <text
                x={mx + s.nx * 13 * side} y={my + s.ny * 13 * side + 4}
                text-anchor="middle" font-size="11" font-weight="600"
                class:list={[t.text, halo]} stroke-width="4" paint-order="stroke"
              >{f.label}</text>
            )}
          </g>
        );
      })}

      <!-- Équipements -->
      {nodes.map((n) => {
        const t = svgTone[n.tone ?? 'sky'];
        return (
          <g transform={`translate(${n.x} ${n.y})`}>
            {n.type === 'router' && (
              <g>
                <ellipse rx="24" ry="17" class:list={[iconBody, t.stroke]} stroke-width="2" />
                <g class={t.stroke} stroke-width="2" stroke-linecap="round" fill="none">
                  <path d="M-13 -7 L-4 -2 M-13 -7 L-12 -2 M-13 -7 L-8 -9" />
                  <path d="M13 7 L4 2 M13 7 L12 2 M13 7 L8 9" />
                  <path d="M4 -2 L13 -7 M13 -7 L8 -9 M13 -7 L12 -2" />
                  <path d="M-4 2 L-13 7 M-13 7 L-8 9 M-13 7 L-12 2" />
                </g>
              </g>
            )}
            {(n.type === 'switch' || n.type === 'l3switch') && (
              <g>
                <rect x="-27" y="-15" width="54" height="30" rx="5" class:list={[iconBody, t.stroke]} stroke-width="2" />
                <g class={t.stroke} stroke-width="2" stroke-linecap="round" fill="none">
                  <path d="M-14 -5 L14 -5 M9 -9 L14 -5 L9 -1" />
                  <path d="M14 5 L-14 5 M-9 1 L-14 5 L-9 9" />
                </g>
                {n.type === 'l3switch' && <text y="-20" text-anchor="middle" font-size="9" font-weight="700" class={t.text}>L3</text>}
              </g>
            )}
            {n.type === 'host' && (
              <g class={t.stroke} stroke-width="2" stroke-linejoin="round">
                <rect x="-19" y="-16" width="38" height="25" rx="3" class={iconBody} />
                <path d="M-7 15 L7 15 M0 9 L0 15" fill="none" stroke-linecap="round" />
              </g>
            )}
            {n.type === 'server' && (
              <g class={t.stroke} stroke-width="2">
                <rect x="-15" y="-20" width="30" height="40" rx="3" class={iconBody} />
                <path d="M-9 -10 L9 -10 M-9 -3 L9 -3" stroke-linecap="round" />
                <circle cx="0" cy="11" r="2" class={t.fill} stroke="none" />
              </g>
            )}
            {n.type === 'cloud' && (
              <path
                d="M-16 12 Q-28 12 -26 1 Q-24 -8 -14 -7 Q-11 -18 1 -17 Q13 -17 15 -6 Q27 -7 27 3 Q27 12 16 12 Z"
                class:list={[iconBody, t.stroke]} stroke-width="2" stroke-linejoin="round"
              />
            )}
            {n.type === 'firewall' && (
              <g class={t.stroke} stroke-width="2">
                <rect x="-22" y="-16" width="44" height="32" rx="3" class={iconBody} />
                <path d="M-22 -5 L22 -5 M-22 5 L22 5 M-8 -16 L-8 -5 M8 -5 L8 5 M-8 5 L-8 16" fill="none" />
              </g>
            )}
            {n.label && (
              <text y={n.type === 'server' ? 38 : 36} text-anchor="middle" font-size="13" font-weight="600" class:list={[labelText, halo]} stroke-width="4" paint-order="stroke">{n.label}</text>
            )}
            {n.sub && (
              <text y={n.type === 'server' ? 53 : 51} text-anchor="middle" font-size="11" font-family="JetBrains Mono Variable, ui-monospace, monospace" class:list={['fill-slate-500 dark:fill-slate-400', halo]} stroke-width="4" paint-order="stroke">{n.sub}</text>
            )}
          </g>
        );
      })}

      <!-- Noms des zones, par-dessus les liens -->
      {groups.filter((g) => g.label).map((g) => (
        <text
          x={g.x + 12} y={g.y + 20} font-size="12" font-weight="600"
          class:list={[svgTone[g.tone ?? 'slate'].text, halo]} stroke-width="4" paint-order="stroke"
        >{g.label}</text>
      ))}

      <!-- Annotations -->
      {notes.map((note) => (
        <text
          x={note.x} y={note.y} text-anchor={note.anchor ?? 'middle'} font-size="12"
          font-family={note.mono ? 'JetBrains Mono Variable, ui-monospace, monospace' : undefined}
          class:list={[svgTone[note.tone ?? 'slate'].text, halo]} stroke-width="4" paint-order="stroke"
        >{note.text}</text>
      ))}
    </svg>
  </div>
  {caption && <figcaption class="mt-3 text-center text-sm text-slate-500">{caption}</figcaption>}
</figure>
