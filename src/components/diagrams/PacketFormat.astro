---
// Format de trame, d'en-tête ou de champ de bits, sur une ou plusieurs lignes alignées.
//
// <PacketFormat
//   cols={12}
//   rows={[
//     { label: 'Trame', fields: [{ label: 'MAC dest.', sub: '6 octets', span: 2, tone: 'amber' }, …] },
//     { label: 'Paquet', fields: [{ label: 'En-tête IP', span: 2, start: 3, tone: 'emerald' }, …] },
//   ]}
//   caption="…"
// />
// `span` = nombre de colonnes occupées, `start` = colonne de départ (1 = première).
import { boxTone, type Tone } from './tones';

interface Field { label: string; sub?: string; span?: number; start?: number; tone?: Tone; dashed?: boolean; mono?: boolean }
interface Row { label?: string; fields: Field[] }

interface Props {
  rows: Row[];
  cols?: number;
  minWidth?: string; // largeur minimale (défilement horizontal sur mobile), ex. "40rem"
  caption?: string;
}

const { rows, cols, minWidth = '36rem', caption } = Astro.props;

const columns = cols ?? Math.max(...rows.map((r) => r.fields.reduce((sum, f) => sum + (f.span ?? 1), 0)));
const hasLabels = rows.some((r) => r.label);
const template = `${hasLabels ? '6.5rem ' : ''}repeat(${columns}, minmax(0, 1fr))`;
const offset = hasLabels ? 1 : 0;
---
<figure class="not-prose my-10">
  <div class="overflow-x-auto pb-1">
    <div class="grid gap-x-1 gap-y-2" style={`grid-template-columns: ${template}; min-width: ${minWidth}`}>
      {rows.map((row, r) => {
        let cursor = 1;
        return (
          <>
            {hasLabels && (
              <div style={`grid-row: ${r + 1}; grid-column: 1`} class="flex items-center pr-2 font-mono text-xs font-medium text-slate-500">
                {row.label}
              </div>
            )}
            {row.fields.map((f) => {
              const start = f.start ?? cursor;
              const span = f.span ?? 1;
              cursor = start + span;
              const t = boxTone[f.tone ?? 'slate'];
              return (
                <div
                  style={`grid-row: ${r + 1}; grid-column: ${start + offset} / span ${span}`}
                  class:list={['flex min-h-14 flex-col items-center justify-center rounded-md border px-1.5 py-2 text-center', t.box, f.dashed && 'border-dashed']}
                >
                  <span class:list={['text-xs font-semibold leading-tight sm:text-sm', t.text, f.mono && 'font-mono']}>{f.label}</span>
                  {f.sub && <span class="mt-0.5 font-mono text-[10px] leading-tight text-slate-500 sm:text-xs">{f.sub}</span>}
                </div>
              );
            })}
          </>
        );
      })}
    </div>
  </div>
  {caption && <figcaption class="mt-3 text-center text-sm text-slate-500">{caption}</figcaption>}
</figure>
