---
// Élévation de baies : des baies vues de face, leurs équipements placés à leur unité (U),
// et les câbles qui passent par le chemin de câbles au-dessus des baies.
//
// <RackElevation
//   racks={[
//     { label: 'Baie A', items: [
//       { u: 41, h: 1, label: 'leaf1', kind: 'switch' },
//       { u: 1, h: 20, label: '20 serveurs 1U', kind: 'server' },
//     ] },
//   ]}
//   links={[{ from: [1, '20 serveurs 1U'], to: [0, 'leaf1'], label: 'DAC' }]}
// />
// `u` est l'unité la plus basse de l'équipement (1 = bas de la baie), `h` sa hauteur en unités.
import { svgTone, type Tone } from './tones';

type Kind = 'switch' | 'server' | 'patch' | 'mgmt' | 'pdu' | 'other';
interface Item { u: number; h?: number; label: string; kind?: Kind; tone?: Tone }
interface Rack { label: string; sub?: string; units?: number; items: Item[] }
interface Link { from: [number, string]; to: [number, string]; tone?: Tone; label?: string }
interface Props { racks: Rack[]; links?: Link[]; unitHeight?: number; caption?: string; minWidth?: string }

const { racks, links = [], unitHeight = 9, caption, minWidth } = Astro.props;

const RACK_W = 130;
const GAP = 56;
const LEFT = 20;
const TRAY = 34; // chemin de câbles
const TOP = 70; // haut des baies
const FRAME = 8;

const maxUnits = Math.max(...racks.map((r) => r.units ?? 42));
const rackH = (r: Rack) => (r.units ?? 42) * unitHeight + 2 * FRAME;
const width = LEFT * 2 + racks.length * RACK_W + (racks.length - 1) * GAP;
const height = TOP + maxUnits * unitHeight + 2 * FRAME + 46;
const rackX = (i: number) => LEFT + i * (RACK_W + GAP);
const rackBottom = (r: Rack) => TOP + rackH(r) - FRAME;

const kindTone: Record<Kind, Tone> = { switch: 'sky', server: 'violet', patch: 'amber', mgmt: 'emerald', pdu: 'rose', other: 'slate' };

// Rectangle de chaque équipement
const boxes = racks.flatMap((r, ri) =>
  r.items.map((it) => {
    const h = (it.h ?? 1) * unitHeight;
    const y = rackBottom(r) - (it.u - 1) * unitHeight - h;
    return { ri, it, x: rackX(ri) + FRAME, y, w: RACK_W - 2 * FRAME, h, tone: svgTone[it.tone ?? kindTone[it.kind ?? 'other']] };
  }),
);
const find = ([ri, label]: [number, string]) => {
  const b = boxes.find((x) => x.ri === ri && x.it.label === label);
  if (!b) throw new Error(`<RackElevation> : équipement "${label}" introuvable dans la baie ${ri}`);
  return b;
};

// Câbles : on sort sur le côté de la baie, on monte au chemin de câbles, on traverse, on redescend
const paths = links.map((l, i) => {
  const a = find(l.from);
  const b = find(l.to);
  const off = 5 + (i % 6) * 4;
  const goRight = b.ri > a.ri || (b.ri === a.ri);
  const ax = goRight ? a.x + a.w : a.x;
  const bx = b.ri === a.ri ? b.x + b.w : goRight ? b.x : b.x + b.w;
  const sideA = goRight ? rackX(a.ri) + RACK_W + off : rackX(a.ri) - off;
  const sideB = b.ri === a.ri ? sideA : goRight ? rackX(b.ri) - off : rackX(b.ri) + RACK_W + off;
  const ay = a.y + a.h / 2;
  const by = b.y + b.h / 2;
  const tray = TRAY + (i % 6) * 3;
  const d = b.ri === a.ri
    ? `M ${ax} ${ay} H ${sideA} V ${by} H ${bx}`
    : `M ${ax} ${ay} H ${sideA} V ${tray} H ${sideB} V ${by} H ${bx}`;
  return { d, tone: svgTone[l.tone ?? 'emerald'], label: l.label, lx: (sideA + sideB) / 2, ly: tray - 5 };
});
---
<figure class="not-prose my-10">
  <div class="overflow-x-auto">
    <svg viewBox={`0 0 ${width} ${height}`} class="mx-auto block h-auto w-full" style={`min-width: ${minWidth ?? `${Math.min(width, 560)}px`}; max-width: ${width}px`} role="img" aria-label={caption ?? 'Élévation de baies'}>
      <!-- Chemin de câbles -->
      <rect x={LEFT - 10} y={TRAY - 12} width={width - 2 * LEFT + 20} height={24} rx="4" class="fill-slate-100 dark:fill-slate-800/60" />

      {racks.map((r, i) => (
        <g>
          <rect x={rackX(i)} y={TOP} width={RACK_W} height={rackH(r)} rx="4" stroke-width="2" class="fill-slate-50 stroke-slate-400 dark:fill-slate-900 dark:stroke-slate-600" />
          <text x={rackX(i) + RACK_W / 2} y={TOP + rackH(r) + 18} text-anchor="middle" font-size="13" font-weight="600" class="fill-slate-900 dark:fill-white">{r.label}</text>
          {r.sub && <text x={rackX(i) + RACK_W / 2} y={TOP + rackH(r) + 33} text-anchor="middle" font-size="11" class="fill-slate-500 dark:fill-slate-400 font-mono">{r.sub}</text>}
        </g>
      ))}

      {paths.map((p) => <path d={p.d} fill="none" stroke-width="2" stroke-linejoin="round" class:list={[p.tone.stroke, 'opacity-80']} />)}

      {boxes.map((b) => (
        <g>
          <rect x={b.x} y={b.y + 0.5} width={b.w} height={b.h - 1} rx="2" stroke-width="1.2" class:list={[b.tone.soft, b.tone.stroke]} />
          {b.h >= 7 && (
            <text x={b.x + b.w / 2} y={b.y + b.h / 2} dy="0.35em" text-anchor="middle" font-size={b.h >= 14 ? 11 : Math.min(9, b.h - 0.5)} font-weight="600" class={b.tone.text}>{b.it.label}</text>
          )}
        </g>
      ))}

      {paths.filter((p) => p.label).map((p) => (
        <text x={p.lx} y={p.ly} text-anchor="middle" font-size="10" class="fill-slate-500 dark:fill-slate-400 font-mono">{p.label}</text>
      ))}
    </svg>
  </div>
  {caption && <figcaption class="mt-3 text-center text-sm text-slate-500">{caption}</figcaption>}
</figure>
