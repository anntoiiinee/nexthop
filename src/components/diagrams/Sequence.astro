---
// Diagramme de séquence en SVG : des acteurs en colonnes et les messages échangés, de haut en bas.
//
// <Sequence
//   actors={[{ id: 'client', label: 'Client', sub: '192.0.2.10' }, { id: 'srv', label: 'Serveur', tone: 'violet' }]}
//   messages={[
//     { from: 'client', to: 'srv', label: 'ClientHello', sub: 'SNI = app.example.com', tone: 'emerald' },
//     { from: 'srv', to: 'client', label: '403 Forbidden', style: 'blocked' },
//     { note: 'Tout ce qui suit est chiffré', tone: 'violet' },
//   ]}
//   caption="…"
// />
// `style` : 'solid' (par défaut), 'dashed' (réponse, message facultatif) ou 'blocked' (refusé, en rouge).
// `note` : bandeau sur toute la largeur, ou entre deux acteurs avec `over: ['client', 'srv']`.
import { svgTone, type Tone } from './tones';

interface Actor { id: string; label: string; sub?: string; tone?: Tone }
interface Message { from: string; to: string; label: string; sub?: string; tone?: Tone; style?: 'solid' | 'dashed' | 'blocked' }
interface Note { note: string; over?: [string, string]; tone?: Tone }
type Step = Message | Note;

interface Props {
  actors: Actor[];
  messages: Step[];
  width?: number;
  minWidth?: number; // largeur minimale à l'écran (défilement horizontal sur mobile)
  caption?: string;
}

const { actors, messages, width = 640, minWidth, caption } = Astro.props;

// Largeur des cartouches d'acteurs, puis marge pour qu'ils ne débordent pas du cadre
const boxW = Math.min(Math.max((width - 160) / Math.max(actors.length - 1, 1) - 16, 96), 150);
const margin = boxW / 2 + 6;
const step = actors.length > 1 ? (width - 2 * margin) / (actors.length - 1) : 0;
const xOf = Object.fromEntries(actors.map((a, i) => [a.id, actors.length > 1 ? margin + i * step : width / 2]));
const x = (id: string) => {
  if (!(id in xOf)) throw new Error(`<Sequence> : acteur inconnu "${id}"`);
  return xOf[id];
};

const isNote = (m: Step): m is Note => 'note' in m;
const headH = actors.some((a) => a.sub) ? 54 : 40;
const top = headH + 22;

// Position verticale de chaque étape
let y = top;
const rows = messages.map((m) => {
  const h = isNote(m) ? 34 : m.sub ? 48 : 36;
  const row = { m, y, h };
  y += h;
  return row;
});
const height = y + 16;

const halo = 'stroke-white dark:stroke-slate-950';
const mono = 'JetBrains Mono Variable, ui-monospace, monospace';
---
<figure class="not-prose my-10">
  <div class="overflow-x-auto">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      class="mx-auto block h-auto w-full"
      style={`max-width: ${width}px; min-width: ${minWidth ?? Math.min(width, 520)}px`}
      role="img"
      aria-label={caption}
      font-family="Inter Variable, ui-sans-serif, system-ui, sans-serif"
    >
      <!-- Lignes de vie -->
      {actors.map((a) => (
        <line x1={x(a.id)} y1={headH} x2={x(a.id)} y2={height - 6} class={svgTone[a.tone ?? 'slate'].stroke} stroke-width="1.5" stroke-dasharray="4 4" />
      ))}

      <!-- Acteurs -->
      {actors.map((a) => {
        const t = svgTone[a.tone ?? 'slate'];
        const w = boxW;
        return (
          <g transform={`translate(${x(a.id)} 0)`}>
            <rect x={-w / 2} y="2" width={w} height={headH - 6} rx="8" class:list={[t.soft, t.stroke]} stroke-width="1.5" />
            <text y={a.sub ? 22 : 26} text-anchor="middle" font-size="13" font-weight="600" class="fill-slate-900 dark:fill-white">{a.label}</text>
            {a.sub && <text y="40" text-anchor="middle" font-size="11" font-family={mono} class="fill-slate-500 dark:fill-slate-400">{a.sub}</text>}
          </g>
        );
      })}

      <!-- Messages et notes -->
      {rows.map(({ m, y, h }) => {
        if (isNote(m)) {
          const t = svgTone[m.tone ?? 'slate'];
          const [x1, x2] = m.over ? [x(m.over[0]), x(m.over[1])].sort((a, b) => a - b) : [margin, width - margin];
          const pad = Math.min(40, margin - 4);
          return (
            <g>
              <rect x={x1 - pad} y={y + 4} width={x2 - x1 + 2 * pad} height={h - 10} rx="6" class:list={[t.soft, t.stroke]} stroke-width="1" />
              <text x={(x1 + x2) / 2} y={y + h / 2 + 3} text-anchor="middle" font-size="11.5" font-weight="600" class={t.text}>{m.note}</text>
            </g>
          );
        }
        const style = m.style ?? 'solid';
        const t = svgTone[m.tone ?? (style === 'blocked' ? 'rose' : 'sky')];
        const x1 = x(m.from), x2 = x(m.to);
        const dir = x2 >= x1 ? 1 : -1;
        const ly = y + 22;
        const head = 8;
        const tip = x2 - dir * 3;
        return (
          <g>
            <line
              x1={x1 + dir * 3} y1={ly} x2={tip - dir * head} y2={ly}
              class={t.stroke} stroke-width="2" stroke-linecap="round"
              stroke-dasharray={style === 'dashed' ? '6 5' : undefined}
            />
            {style === 'blocked' ? (
              <g transform={`translate(${tip - dir * 6} ${ly})`} class="stroke-rose-500" stroke-width="2.5" stroke-linecap="round">
                <path d="M-5 -5 L5 5 M5 -5 L-5 5" />
              </g>
            ) : (
              <polygon points={`${tip},${ly} ${tip - dir * head},${ly - 5} ${tip - dir * head},${ly + 5}`} class={t.fill} />
            )}
            <text
              x={(x1 + x2) / 2} y={ly - 7} text-anchor="middle" font-size="12" font-weight="600"
              class:list={[t.text, halo]} stroke-width="4" paint-order="stroke"
            >{m.label}</text>
            {m.sub && (
              <text
                x={(x1 + x2) / 2} y={ly + 16} text-anchor="middle" font-size="10.5" font-family={mono}
                class:list={['fill-slate-500 dark:fill-slate-400', halo]} stroke-width="4" paint-order="stroke"
              >{m.sub}</text>
            )}
          </g>
        );
      })}
    </svg>
  </div>
  {caption && <figcaption class="mt-3 text-center text-sm text-slate-500">{caption}</figcaption>}
</figure>
