---
// Graphe de commits Git : une ligne par branche, les commits de gauche à droite dans l'ordre chronologique.
// <GitGraph
//   branches={[{ name: 'main', tone: 'sky' }, { name: 'feature/vlan-40', tone: 'emerald' }]}
//   commits={[
//     { id: 'a1', branch: 0, label: 'Initial' },
//     { id: 'b1', branch: 1, label: 'Ajout VLAN 40', parents: ['a1'] },
//     { id: 'm1', branch: 0, label: 'Merge', parents: ['a1', 'b1'] },
//   ]}
// />
// Sans `parents`, un commit a pour parent le commit précédent de sa branche.
// `tag` affiche une étiquette au-dessus du commit (HEAD, v1.0…).
import { svgTone, type Tone } from './tones';

interface Branch { name: string; tone?: Tone }
interface Commit { id: string; branch: number; label?: string; parents?: string[]; tag?: string }
interface Props { branches: Branch[]; commits: Commit[]; caption?: string }

const { branches, commits, caption } = Astro.props;

const STEP = 92;
const LANE = 62;
const LEFT = 150;
const TOP = 46;
const R = 9;

const width = LEFT + Math.max(commits.length - 1, 1) * STEP + 60;
const height = TOP + (branches.length - 1) * LANE + 50;
const pos = new Map(commits.map((c, i) => [c.id, { x: LEFT + i * STEP, y: TOP + c.branch * LANE, c }]));

// Parent par défaut : le commit précédent sur la même branche
const parentsOf = (c: Commit, i: number) => {
  if (c.parents) return c.parents;
  const prev = [...commits.slice(0, i)].reverse().find((p) => p.branch === c.branch);
  return prev ? [prev.id] : [];
};

const edges = commits.flatMap((c, i) =>
  parentsOf(c, i).map((pid) => {
    const p = pos.get(pid);
    if (!p) throw new Error(`<GitGraph> : parent inconnu "${pid}"`);
    const q = pos.get(c.id)!;
    // Lien qui change de ligne : courbe ; la couleur est celle de la branche d'arrivée
    const tone = svgTone[branches[c.branch].tone ?? 'slate'];
    const d = p.y === q.y
      ? `M ${p.x} ${p.y} L ${q.x} ${q.y}`
      : `M ${p.x} ${p.y} C ${p.x + STEP * 0.6} ${p.y}, ${q.x - STEP * 0.6} ${q.y}, ${q.x} ${q.y}`;
    return { d, cls: tone.stroke };
  }),
);

// Ligne de chaque branche, du premier au dernier commit, et nom de la branche à gauche
const lanes = branches.map((b, bi) => {
  const own = commits.filter((c) => c.branch === bi).map((c) => pos.get(c.id)!.x);
  return { ...b, y: TOP + bi * LANE, tone: svgTone[b.tone ?? 'slate'], x1: Math.min(...own), x2: Math.max(...own) };
});
---
<figure class="not-prose my-10">
  <div class="overflow-x-auto">
    <svg viewBox={`0 0 ${width} ${height}`} class="mx-auto block h-auto w-full font-mono" style={`min-width: ${Math.min(width, 560)}px; max-width: ${width}px`} role="img" aria-label={caption ?? 'Git'}>
      {lanes.map((lane) => (
        <text x={LEFT - 28} y={lane.y} dy="0.35em" text-anchor="end" font-size="13" font-weight="600" class={lane.tone.text}>{lane.name}</text>
      ))}
      {edges.map((e) => <path d={e.d} fill="none" stroke-width="3" class={e.cls} />)}
      {commits.map((c) => {
        const p = pos.get(c.id)!;
        const tone = svgTone[branches[c.branch].tone ?? 'slate'];
        return (
          <g>
            <circle cx={p.x} cy={p.y} r={R} stroke-width="3" class:list={[tone.stroke, 'fill-white dark:fill-slate-950']} />
            <text x={p.x} y={p.y + 26} text-anchor="middle" font-size="11" class="fill-slate-600 dark:fill-slate-400">{c.label ?? c.id}</text>
            {c.tag && (
              <text x={p.x} y={p.y - 18} text-anchor="middle" font-size="11" font-weight="600" class={tone.text}>{c.tag}</text>
            )}
          </g>
        );
      })}
    </svg>
  </div>
  {caption && <figcaption class="mt-3 text-center text-sm text-slate-500">{caption}</figcaption>}
</figure>
