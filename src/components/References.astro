---
// « Documentation officielle » en bas des chapitres et des tutoriels (données dans src/data/references.ts)
import { t, type Lang } from '@/i18n/ui';
import { referencesFor } from '@/data/references';

interface Props { refKey: string; lang: Lang }
const { refKey, lang } = Astro.props;
const refs = referencesFor(refKey);
---
{refs.length > 0 && (
  <section class="not-prose mt-12 rounded-xl border border-slate-200 p-5 dark:border-slate-800" data-pagefind-ignore>
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-900 dark:text-white">{t(lang, 'refs.title')}</h2>
    <p class="mt-1 text-sm text-slate-500">{t(lang, 'refs.intro')}</p>
    <ul class="mt-4 space-y-2.5">
      {refs.map((r) => (
        <li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm">
          <span class="shrink-0 rounded bg-slate-100 px-1.5 py-0.5 font-mono text-[11px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">{r.source}</span>
          <a href={r.url} target="_blank" rel="noopener" class="min-w-0 break-words font-medium text-sky-700 hover:underline dark:text-sky-400">{r.title}</a>
        </li>
      ))}
    </ul>
  </section>
)}
