---
// Boutons de partage : liens directs vers chaque plateforme (aucun script tiers, aucun pistage),
// copie du lien, et partage natif du téléphone quand le navigateur le propose.
import { t, type Lang } from '@/i18n/ui';
import { shareIcons } from '@/data/shareIcons';

interface Props { title: string; url: string; lang: Lang; class?: string }
const { title, url, lang, class: className } = Astro.props;

const u = encodeURIComponent(url);
const tt = encodeURIComponent(title);
const both = encodeURIComponent(`${title} ${url}`);

const platforms = [
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  { name: 'X', icon: 'x', href: `https://twitter.com/intent/tweet?url=${u}&text=${tt}` },
  { name: 'Bluesky', icon: 'bluesky', href: `https://bsky.app/intent/compose?text=${both}` },
  { name: 'Facebook', icon: 'facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { name: 'Reddit', icon: 'reddit', href: `https://www.reddit.com/submit?url=${u}&title=${tt}` },
  { name: 'WhatsApp', icon: 'whatsapp', href: `https://wa.me/?text=${both}` },
  { name: 'Telegram', icon: 'telegram', href: `https://t.me/share/url?url=${u}&text=${tt}` },
];

const btn = 'inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:border-sky-400 hover:text-sky-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:text-sky-400';
const shareIcon = 'M18 8a3 3 0 1 0-2.8-4M6 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm12 7a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM8.6 13.5l6.8 4M15.4 6.5l-6.8 4';
---
<div data-share data-pagefind-ignore data-copied={t(lang, 'share.copied')} class:list={['not-prose', className]}>
  <p class="text-sm font-semibold text-slate-900 dark:text-white">{t(lang, 'share.title')}</p>
  <div class="mt-3 flex flex-wrap gap-2">
    <button type="button" data-native data-title={title} data-url={url} hidden class={btn}>
      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={shareIcon} /></svg>
      {t(lang, 'share.native')}
    </button>
    {platforms.map((p) => (
      <a href={p.href} target="_blank" rel="noopener noreferrer" class={btn} aria-label={`${t(lang, 'share.on')} ${p.name}`}>
        {p.icon ? (
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d={shareIcons[p.icon]} /></svg>
        ) : (
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={shareIcon} /></svg>
        )}
        {p.name}
      </a>
    ))}
    <a href={`mailto:?subject=${tt}&body=${u}`} class={btn}>
      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
      {t(lang, 'share.email')}
    </a>
    <button type="button" data-copy data-url={url} class={btn}>
      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1" /><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1" /></svg>
      <span data-copy-label>{t(lang, 'share.copy')}</span>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-share]').forEach((root) => {
    const native = root.querySelector<HTMLButtonElement>('[data-native]')!;
    if (typeof navigator.share === 'function') {
      native.hidden = false;
      native.addEventListener('click', () => {
        navigator.share({ title: native.dataset.title, url: native.dataset.url }).catch(() => {});
      });
    }
    const copy = root.querySelector<HTMLButtonElement>('[data-copy]')!;
    const label = copy.querySelector<HTMLElement>('[data-copy-label]')!;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.url!);
        const original = label.textContent;
        label.textContent = root.dataset.copied!;
        setTimeout(() => (label.textContent = original), 1800);
      } catch {}
    });
  });
</script>
