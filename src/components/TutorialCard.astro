---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '@/i18n/ui';
import ContentDates from './ContentDates.astro';
import { updatedDateOf } from '@/lib/dates';
import { levelColors } from '@/lib/levels';
import { slugOf, tutorialUrl } from '@/lib/content';

interface Props {
  post: CollectionEntry<'tutorials'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const { title, description, level, tags, pubDate, wip } = post.data;
const updated = updatedDateOf(post);
const href = tutorialUrl(lang, slugOf(post.id));
---
<a
  href={href}
  class="group flex flex-col rounded-xl border border-slate-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-sky-400 hover:shadow-lg hover:shadow-sky-500/5 dark:border-slate-800 dark:bg-slate-900/50 dark:hover:border-sky-500/60"
>
  <div class="mb-3 flex items-center gap-3 text-xs font-medium">
    <span class:list={['rounded-full px-2.5 py-1', levelColors[level]]}>
      {t(lang, `level.${level}`)}
    </span>
    {wip && (
      <span class="rounded-full border border-dashed border-slate-300 px-2.5 py-1 text-slate-500 dark:border-slate-600 dark:text-slate-400">
        {t(lang, 'tutorials.wip')}
      </span>
    )}
  </div>
  <h3 class="text-lg font-semibold text-slate-900 transition group-hover:text-sky-600 dark:text-white dark:group-hover:text-sky-400">
    {title}
  </h3>
  <p class="mt-2 line-clamp-3 flex-1 text-sm text-slate-600 dark:text-slate-400">{description}</p>
  <ContentDates created={pubDate} updated={updated} lang={lang} class="mt-3 text-xs" />
  {tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2 font-mono text-xs text-slate-500">
      {tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
    </div>
  )}
</a>