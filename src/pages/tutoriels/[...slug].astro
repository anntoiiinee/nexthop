---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getTutorialPaths } from '../../lib/content';

export const getStaticPaths = () => getTutorialPaths('fr');

const { post, alternates } = Astro.props;
const { Content, headings } = await render(post);
---
<ArticleLayout post={post} headings={headings} lang="fr" alternates={alternates}>
  <Content />
</ArticleLayout>