---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="404 | Next Hop" lang="fr" searchable={false}>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center">
    <p class="font-mono text-sm text-slate-500"><span class="text-sky-500">$</span> ping page-introuvable</p>
    <p class="mt-2 font-mono text-sm text-rose-500">Destination host unreachable</p>
    <h1 class="mt-8 text-4xl font-bold text-slate-900 dark:text-white">404</h1>
    <p class="mt-4 text-slate-600 dark:text-slate-400">Cette page n'existe pas, ou plus. / This page doesn't exist.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="rounded-lg bg-sky-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-sky-600">Accueil</a>
      <a href="/en/" class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-semibold dark:border-slate-700">Home</a>
    </div>
  </section>
</BaseLayout>