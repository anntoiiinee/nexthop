---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { t, type Lang } from '@/i18n/ui';
import { levelColors } from '@/lib/levels';
import Callout from '@/components/Callout.astro';
import SupportCard from '@/components/SupportCard.astro';
import ShareButtons from '@/components/ShareButtons.astro';
import ContentDates from '@/components/ContentDates.astro';
import { updatedDateOf } from '@/lib/dates';
import { routes } from '@/i18n/ui';
import { absoluteUrl, authorSchema, breadcrumbSchema, ogImagePath } from '@/lib/seo';

interface Props {
  post: CollectionEntry<'tutorials'> | CollectionEntry<'courses'>;
  headings: MarkdownHeading[];
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
  breadcrumbs?: { name: string; path: string }[]; // fil d'Ariane (données structurées), sans la page elle-même
}

const { post, headings, lang, alternates, breadcrumbs } = Astro.props;
const { title, description, pubDate, level, tags } = post.data;
const updatedDate = updatedDateOf(post);
const wip = post.data.wip; // tutoriel en cours de rédaction : visible, mais pas indexé
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const path = Astro.url.pathname;
const image = ogImagePath(post.collection, post.id);
const trail = breadcrumbs ?? [
  { name: t(lang, 'nav.home'), path: routes.home[lang] },
  { name: t(lang, 'nav.tutorials'), path: routes.tutorials[lang] },
];
const jsonLd = [
  {
    '@type': 'TechArticle',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    inLanguage: lang,
    keywords: tags.join(', '),
    proficiencyLevel: { beginner: 'Beginner', intermediate: 'Intermediate', advanced: 'Expert' }[level],
    image: absoluteUrl(image),
    mainEntityOfPage: absoluteUrl(path),
    author: authorSchema(lang),
    publisher: { '@id': 'https://nexthop.alcpt.network/#author' },
  },
  breadcrumbSchema([...trail, { name: title, path }]),
];
---
<BaseLayout
  image={image}
  title={`${title} | Next Hop`}
  description={description}
  lang={lang}
  alternates={alternates}
  article={{ published: pubDate, modified: updatedDate, tags }}
  jsonLd={jsonLd}
  noindex={wip}
>
  <div class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)] gap-12 px-4 py-12 lg:grid-cols-[minmax(0,1fr)_14rem]">
    <article>
      <slot name="before"/>
      <header class="mb-10 border-b border-slate-200 pb-8 dark:border-slate-800">
        <div class="mb-4 flex flex-wrap items-center gap-2 text-xs font-medium">
          <span class:list={['rounded-full px-2.5 py-1', levelColors[level]]}>
            {t(lang, `level.${level}`)}
          </span>
          {tags.map((tag) => (
            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-slate-600 dark:bg-slate-800 dark:text-slate-400">
              #{tag}
            </span>
          ))}
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">{title}</h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">{description}</p>
        <ContentDates created={pubDate} updated={updatedDate} lang={lang} class="mt-4 text-sm" />
      </header>

      <div class="prose prose-slate max-w-none dark:prose-invert prose-headings:scroll-mt-24 prose-a:text-sky-600 dark:prose-a:text-sky-400">
        {wip && <Callout type="note" title={t(lang, 'tutorials.wip')} lang={lang}>{t(lang, 'tutorials.wipBanner')}</Callout>}
        <slot />
      </div>
      <ShareButtons title={title} url={absoluteUrl(path)} lang={lang} class="mt-16 border-t border-slate-200 pt-8 dark:border-slate-800" />
      <SupportCard lang={lang} title={title} />
      <slot name="after" />
    </article>

    {toc.length > 0 && (
      <aside class="hidden lg:block" data-pagefind-ignore>
        <nav class="sticky top-24 flex max-h-[calc(100vh-8rem)] flex-col text-sm">
          <p class="mb-3 font-semibold text-slate-900 dark:text-white">{t(lang, 'article.toc')}</p>
          <ul class="min-h-0 space-y-2 overflow-y-auto overscroll-contain border-l border-slate-200 pb-2 [scrollbar-width:thin] dark:border-slate-800" data-toc>
            {toc.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  data-toc-link={h.slug}
                  class:list={[
                    '-ml-px block border-l border-transparent text-slate-500 transition hover:border-sky-500 hover:text-sky-600 dark:hover:text-sky-400',
                    'aria-[current=location]:border-sky-500 aria-[current=location]:font-medium aria-[current=location]:text-sky-700 dark:aria-[current=location]:text-sky-300',
                    h.depth === 3 ? 'pl-8' : 'pl-4',
                  ]}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>

<script>
  // Sommaire « Sur cette page » : surligne la section en cours de lecture, et fait défiler la liste du
  // sommaire (si elle est plus haute que l'écran) pour garder cette entrée visible.
  const nav = document.querySelector<HTMLElement>('[data-toc]');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const headings = links
      .map((a) => document.getElementById(a.dataset.tocLink ?? ''))
      .filter((h): h is HTMLElement => h !== null);
    let current: HTMLAnchorElement | undefined;
    let ticking = false;

    const update = () => {
      ticking = false;
      // Le dernier titre passé sous le haut de l'écran ; en bas de page, le dernier titre
      const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      let active = atBottom ? headings[headings.length - 1] : undefined;
      // Une section devient active quand son titre passe le premier tiers de l'écran
      const threshold = Math.max(120, innerHeight / 3);
      if (!active) for (const h of headings) if (h.getBoundingClientRect().top <= threshold) active = h;
      const link = links.find((a) => a.dataset.tocLink === active?.id);
      if (link === current) return;
      current?.removeAttribute('aria-current');
      current = link;
      if (!link) return;
      link.setAttribute('aria-current', 'location');
      // Faire défiler le sommaire seulement, jamais la page
      const top = link.getBoundingClientRect().top - nav.getBoundingClientRect().top + nav.scrollTop;
      if (top < nav.scrollTop + 40 || top > nav.scrollTop + nav.clientHeight - 60) {
        nav.scrollTo({ top: top - nav.clientHeight / 3, behavior: 'smooth' });
      }
    };
    const onScroll = () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>