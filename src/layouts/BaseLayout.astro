---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { languages, routes, t, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  lang: Lang;
  description?: string;
  alternates?: Partial<Record<Lang, string>>;
}

const {
  title,
  lang,
  description = t(lang, 'site.description'),
  alternates = routes.home,
} = Astro.props;

const langs = Object.keys(languages) as Lang[];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {Object.entries(alternates).map(([l, href]) => (
      <link rel="alternate" hreflang={l} href={new URL(href, Astro.site)} />
    ))}
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-slate-700 antialiased dark:bg-slate-950 dark:text-slate-300">
    <header class="sticky top-0 z-20 border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
        <a href={routes.home[lang]} class="flex items-center gap-2 text-lg font-semibold text-slate-900 dark:text-white">
          <span class="font-mono text-sky-500">&gt;</span>
          <span>next<span class="text-sky-500">hop</span></span>
        </a>
        <div class="flex items-center gap-6 text-sm font-medium">
          <a href={routes.tutorials[lang]} class="transition hover:text-sky-500">{t(lang, 'nav.tutorials')}</a>
          <a href={routes.courses[lang]} class="transition hover:text-sky-500">{t(lang, 'nav.courses')}</a>
          <a href={routes.whoami[lang]} class="font-mono transition hover:text-sky-500">whoami</a>
          
          <div class="flex items-center gap-0.5 rounded-md border border-slate-300 p-0.5 font-mono text-xs dark:border-slate-700">
            {langs.map((l) =>
              l === lang ? (
                <span class="rounded bg-slate-900 px-2 py-0.5 text-white dark:bg-white dark:text-slate-900">
                  {languages[l]}
                </span>
              ) : (
                <a
                  href={alternates[l] ?? routes.home[l]}
                  hreflang={l}
                  title={t(lang, 'lang.switch')}
                  class="rounded px-2 py-0.5 transition hover:text-sky-500"
                >
                  {languages[l]}
                </a>
              )
            )}
          </div>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-200 py-8 text-center text-sm text-slate-500 dark:border-slate-800">
      © {new Date().getFullYear()} Next Hop · {t(lang, 'site.tagline')}
    </footer>
  </body>
</html>