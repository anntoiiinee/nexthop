---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';
import { languages, routes, t, type Lang } from '@/i18n/ui';
import Search from '@/components/Search.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { coffeeUrl, coffeeIcon, issuesUrl } from '@/lib/support';
import { absoluteUrl, ogLocale, SITE_NAME, DEFAULT_IMAGE } from '@/lib/seo';
import { profile } from '@/data/profile';
import { rssUrl } from '@/lib/rss';

interface Props {
  title: string;
  lang: Lang;
  description?: string;
  alternates?: Partial<Record<Lang, string>>;
  searchable?: boolean; // false = page exclue de l'index Pagefind (ex. 404)
  noindex?: boolean;    // true = page exclue de Google (ex. 404)
  image?: string;       // image de partage (Open Graph), 1200×630 ; par défaut l'image du site
  article?: { published: Date; modified?: Date; tags?: string[] }; // og:type article
  jsonLd?: object[];    // données structurées schema.org, réunies dans un @graph
}

const {
  title,
  lang,
  description = t(lang, 'site.description'),
  alternates = routes.home,
  searchable = true,
  noindex = false,
  image = DEFAULT_IMAGE,
  article,
  jsonLd = [],
} = Astro.props;

// URL canonique : l'URL propre de la page, sans paramètres (?tech=…) ni slash manquant
const canonical = absoluteUrl(Astro.url.pathname);
const imageUrl = absoluteUrl(image);
const otherLangs = (Object.keys(alternates) as Lang[]).filter((l) => l !== lang);

const langs = Object.keys(languages) as Lang[];

const navLinks = [
  { href: routes.tutorials[lang], label: t(lang, 'nav.tutorials') },
  { href: routes.courses[lang], label: t(lang, 'nav.courses') },
  { href: routes.tools[lang], label: t(lang, 'nav.tools') },
  { href: routes.further[lang], label: t(lang, 'nav.further') },
  { href: routes.whoami[lang], label: 'whoami', mono: true },
];
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0f172a" />
    <!-- Thème posé avant l'affichage pour éviter un flash clair en mode sombre -->
    <script is:inline>
      (() => {
        let stored = null;
        try { stored = localStorage.getItem('theme'); } catch {}
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>

    <!-- Référencement -->
    <meta name="author" content={profile.name} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} (${languages[lang]})`} href={rssUrl(lang)} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {Object.entries(alternates).map(([l, href]) => (
          <link rel="alternate" hreflang={l} href={absoluteUrl(href)} />
        ))}
        {alternates.fr && <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates.fr)} />}
      </>
    )}

    <!-- Aperçus de partage (LinkedIn, Slack, Discord, X…) -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {otherLangs.map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd })} />
    )}
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-slate-700 antialiased dark:bg-slate-950 dark:text-slate-300">
    <header class="sticky top-0 z-20 border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80">
      <nav aria-label={t(lang, 'nav.menu')} class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 md:h-16 md:flex-nowrap md:py-0">
        <a href={routes.home[lang]} class="flex items-center gap-2 text-lg font-semibold text-slate-900 dark:text-white">
          <span class="font-mono text-sky-500">&gt;</span>
          <span>next<span class="text-sky-500">hop</span></span>
        </a>

        <!-- Mobile : 2e ligne pleine largeur. Desktop : entre le logo et le sélecteur. -->
        <div class="order-last flex w-full items-center justify-between text-sm font-medium sm:justify-start sm:gap-6 md:order-none md:ml-auto md:w-auto">
          {navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={['py-1 transition hover:text-sky-500 aria-[current=page]:text-sky-500', link.mono && 'font-mono']}
            >
              {link.label}
            </a>
          ))}
        </div>

        <div class="flex items-center gap-2">
          <Search lang={lang} />
          <ThemeToggle lang={lang} />

          <div class="flex items-center gap-0.5 rounded-md border border-slate-300 p-0.5 font-mono text-xs dark:border-slate-700">
          {langs.map((l) =>
            l === lang ? (
              <span class="rounded bg-slate-900 px-2 py-0.5 text-white dark:bg-white dark:text-slate-900">
                {languages[l]}
              </span>
            ) : (
              <a
                href={alternates[l] ?? routes.home[l]}
                hreflang={l}
                title={t(lang, 'lang.switch')}
                class="rounded px-2 py-0.5 transition hover:text-sky-500"
              >
                {languages[l]}
              </a>
            )
          )}
          </div>
        </div>
      </nav>
    </header>

    <main class="flex-1 overflow-x-clip" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>

    <footer class="border-t border-slate-200 py-8 text-sm text-slate-500 dark:border-slate-800">
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 sm:flex-row sm:justify-between">
        <p>© {new Date().getFullYear()} Next Hop · {t(lang, 'site.tagline')}</p>
        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
          <a href={rssUrl(lang)} class="inline-flex items-center gap-1.5 transition hover:text-sky-500">
            <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1.5" fill="currentColor" />
            </svg>
            RSS
          </a>
          <a href={issuesUrl} target="_blank" rel="noopener" class="transition hover:text-sky-500">{t(lang, 'support.report')} / {t(lang, 'support.suggest').toLowerCase()} ↗</a>
          {coffeeUrl && (
            <a href={coffeeUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-medium text-slate-700 transition hover:text-sky-500 dark:text-slate-300">
              <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d={coffeeIcon} /></svg>
              {t(lang, 'support.coffee')}
            </a>
          )}
        </div>
      </div>
    </footer>
  </body>
</html>